#include "FreeRTOS.h"
#include "task.h"
#include "queue.h"
#include "semphr.h"
#include "timers.h"

// 本模板专用于 FreeRTOS CORTEX_MPS2_QEMU_IAR_GCC Demo（非 MPU 端口）
#include <stdio.h>
#include <stdint.h>
#include <stddef.h>
#include <string.h>

// LibAFL集成必需的全局变量和函数
#define MAX_FUZZ_INPUT_SIZE 1024
__attribute__((used, visibility("default"))) unsigned char FUZZ_INPUT[MAX_FUZZ_INPUT_SIZE] = {
    // 默认种子：在修复阶段提供确定性输入，Fuzzer 运行时会覆盖此缓冲区
    0x46, 0x55, 0x5a, 0x5a, 0x01, 0x23, 0x45, 0x67,
    0x89, 0xab, 0xcd, 0xef, 0x11, 0x22, 0x33, 0x44,
    0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc,
    0xdd, 0xee, 0xff, 0x00, 0x13, 0x37, 0x42, 0x24,
    0x5a, 0xa5, 0xc3, 0x3c, 0xde, 0xed, 0xbe, 0xef,
    0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80,
    0x90, 0xa0, 0xb0, 0xc0, 0xd0, 0xe0, 0xf0, 0x0f,
    0x1f, 0x2f, 0x3f, 0x4f, 0x5f, 0x6f, 0x7f, 0x8f
};

// LibAFL断点函数
// 语义约定：一旦进入该函数，视为当前 harness 已经完成本轮测试，
// 不再返回调用者，而是在一个可控的自旋循环中停住，由 QEMU/LibAFL 捕获。
int __attribute__((noinline, used, visibility("default"))) BREAKPOINT(void)
{
    for (;;) {
        __asm volatile("nop");
    }
}

#define FUZZ_TASK_STACK_DEPTH (configMINIMAL_STACK_SIZE * 4)
static StackType_t xFuzzTaskStack[FUZZ_TASK_STACK_DEPTH];
static StaticTask_t xFuzzTaskTCB;
#define FUZZ_TASK_PRIORITY (tskIDLE_PRIORITY + 1)

// ====================================================================
// 测试用例辅助函数和全局变量（统一前缀 FR_*）
// ====================================================================
// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
/* Static storage for the spawned task used by each iteration. */
static StaticTask_t xtestTaskBuffer;
static StackType_t xTestStack[256];
static volatile BaseType_t xSpawnedRan = 0;

/* Spawned task: optionally suspends itself immediately depending on pvParameters LSB. */
static void vSpawnedTask( void *pvParameters )
{
    /* Mark that the task ran at least once. */
    xSpawnedRan = 1;

    /* If the LSB of pvParameters is set, suspend this task to create a Suspended state
       that the fuzzer harness can then attempt to resume. */
    if( pvParameters != NULL && ( ( (uintptr_t) pvParameters & 1U ) != 0U ) )
    {
        vTaskSuspend( NULL ); /* suspend self */
    }

    /* Keep the task alive so it can be resumed/deleted by the test. */
    for( ;; )
    {
        /* Use a small delay to yield to lower priority tasks and avoid busy-waiting. */
        vTaskDelay( 1 );
    }
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void *pvParameters)
{
    (void)pvParameters; /* silence unused parameter warning */

    // 测试用例: vTaskResume_fuzz_case_1
    // API类别: task_management
    // 描述: Create a static helper task that may suspend itself; use fuzz input to decide if the created task self-suspends, whether the test suspends it before resuming, how many resume calls to perform, and the task name/prio. Exercises both resumed-from-suspended and resume-when-not-suspended paths while ensuring the created task is deleted for cleanup.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    /*
     * Reduce the maximum number of iterations to avoid long-running tests in case
     * the target environment has slow ticks or limited scheduling. Keep it bounded.
     */
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 5);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        return;
    }

    // ================= 有界迭代骨架 =================
    for (unsigned int i = 0; i < iterations; ++i) {
        /* Reinitialize reader to deterministic start for this iteration. */
        fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

        /* Consume some entropy (>=16 bytes total across calls per requirements). */
        (void) FR_next_u32(&fr);

        /* Decide whether the spawned task will suspend itself (1) or not (0). */
        uint32_t suspend_self_flag = (uint32_t) FR_next_range(&fr, 0, 1);

        /* How many times to call vTaskResume on the target task (exercise duplicate resumes).
           Restrict to a very small number to avoid long behaviour. */
        uint32_t resume_times = (uint32_t) FR_next_range(&fr, 1, 2);

        /* Optionally suspend the target from this (controller) task before resuming. */
        uint32_t pre_suspend = (uint32_t) FR_next_range(&fr, 0, 1);

        /* Derive a short name from the fuzz input (max 12 bytes). */
        char generated_name_buf[13];
        size_t name_len = FR_next_string(&fr, generated_name_buf, sizeof(generated_name_buf));
        const char * task_name = ( name_len != 0 ) ? generated_name_buf : "fuzzed";

        /* Determine a priority relative to the calling task but clamp into valid range so
           we never pass an out-of-range priority to the kernel. */
        UBaseType_t curr_prio = uxTaskPriorityGet( NULL );
        UBaseType_t prio_offset = (UBaseType_t) FR_next_range(&fr, 0, 2);
        /* Compute desired priority, but clamp to [tskIDLE_PRIORITY, configMAX_PRIORITIES-1]. */
        UBaseType_t desired = curr_prio + 1 + prio_offset;
#if defined(configMAX_PRIORITIES)
        if (desired >= (UBaseType_t)configMAX_PRIORITIES) {
            desired = (UBaseType_t)configMAX_PRIORITIES - 1U;
        }
#endif
        /* Cast tskIDLE_PRIORITY to the same unsigned type to avoid signed/unsigned compare warnings. */
        if (desired < (UBaseType_t)tskIDLE_PRIORITY) {
            desired = (UBaseType_t)tskIDLE_PRIORITY;
        }
        UBaseType_t new_prio = desired;

        /* Create the task statically. Pass suspend_self_flag LSB via pvParameters so the task may
           suspend itself immediately. Use a moderate stack depth (words) that fits xTestStack. */
        TaskHandle_t h = xTaskCreateStatic( vSpawnedTask,
                                            task_name,
                                            (uint32_t) 128,
                                            (void *) (uintptr_t) (suspend_self_flag & 1U),
                                            new_prio,
                                            xTestStack,
                                            &xtestTaskBuffer );
        /* If creation failed, skip this iteration cleanly. */
        if( h == NULL )
        {
            /* Creation failed - nothing to clean up. Proceed to next fuzz iteration. */
            continue;
        }

        /* Allow the spawned task to execute at least one tick so it can suspend itself when requested. */
        vTaskDelay( 1 );

        /* Optionally have this controller task suspend the spawned task before issuing resumes.
           Check that the task is still valid (not deleted) and we are not trying to suspend ourselves. */
        if( pre_suspend )
        {
            TaskHandle_t current = xTaskGetCurrentTaskHandle();
            if( h != current )
            {
                eTaskState st = eTaskGetState(h);
                if (st != eDeleted) {
                    /* Only suspend if task exists. Call is guarded to avoid invalid-kernel-state. */
                    vTaskSuspend( h );
                }
            }
        }

        /* Call vTaskResume multiple times as derived from fuzz input. Avoid attempting to resume the
           calling task (which would be invalid). Additionally guard against deleted handles. */
        for( uint32_t j = 0; j < resume_times; ++j )
        {
            TaskHandle_t current = xTaskGetCurrentTaskHandle();
            if( h != current )
            {
                /* Defensive check: ensure the task handle hasn't been deleted by a race. */
                eTaskState st = eTaskGetState(h);
                if (st == eDeleted) {
                    /* Task gone; nothing to resume. */
                    break;
                }

                /* Only call vTaskResume when the task exists. This prevents undefined behaviour on
                   some ports when resuming an invalid or deleted handle. We allow calling resume even
                   if the task is not in eSuspended state on purpose, but avoid doing so if the task
                   has been deleted. */
                vTaskResume( h );
            }
            else
            {
                /* This should not normally happen; fail safe to catch harness issues. */
                configASSERT( h != current );
            }

            /* Yield a tick to allow resumed task to run if it became ready. */
            vTaskDelay( 0 );
        }

        /* Small delay to allow any resumed task to run. */
        vTaskDelay( 1 );

        /* Cleanup: delete the spawned task created by this iteration if it still exists. */
        if( h != NULL )
        {
            eTaskState st = eTaskGetState(h);
            if (st != eDeleted && h != xTaskGetCurrentTaskHandle()) {
                vTaskDelete( h );
                /* Give the kernel a chance to complete deletion bookkeeping. */
                vTaskDelay( 0 );
            }
            /* Clear the handle locally to avoid accidental reuse. */
            h = NULL;
        }

        /* Reset the spawned ran flag for the next iteration. */
        xSpawnedRan = 0;

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

// FreeRTOS任务包装器（非 MPU 端口，使用普通任务优先级）
void fuzz_task(void)
{
    // 创建模糊测试任务
    TaskHandle_t xHandle = xTaskCreateStatic(
        test_task,
        "FuzzTask",
        FUZZ_TASK_STACK_DEPTH,
        NULL,
        FUZZ_TASK_PRIORITY,
        xFuzzTaskStack,
        &xFuzzTaskTCB
    );

    if (xHandle == NULL) {
        printf("FuzzTask creation failed\n"); 
        fflush(stdout);
        configASSERT(0);
        for (;;) {
        }
    }

    vTaskStartScheduler();

    for (;;) {
    }
}
