/*
 * 测试用例详细信息:
 * 名称: vTaskDelay_fuzz_case_1
 * 描述: Exercise vTaskDelay with small tick values, optionally creating a secondary task at same or lower priority to observe yielding behavior. Parameters are derived from FUZZ_INPUT via FR_* helpers. Uses only static FreeRTOS APIs and static storage. Asserts that a same-priority secondary task runs when vTaskDelay(0) is called.
 * 
 * 生成上下文:
 * 检测到的API函数: TPI_FFSR_TCPresent_Msk             , DWT_MASK_MASK_Msk                  , SCnSCB_ICTR_INTLINESNUM_Msk        , SysTick_CTRL_ENABLE_Msk            , MPS2_SSP2_BASE          , __LDAEX, SysTick_CTRL_COUNTFLAG_Msk         , _FLD2VAL, __NVIC_SystemReset, I2S_CONTROL_RXIRQEN_Msk     
 * 主要文件: /home/zwz/FreeRTOS/FreeRTOS/Demo/CORTEX_MPS2_QEMU_IAR_GCC/main.c, /home/zwz/FreeRTOS/FreeRTOS/Demo/CORTEX_MPS2_QEMU_IAR_GCC/main_full.c, /home/zwz/FreeRTOS/FreeRTOS/Demo/CORTEX_MPS2_QEMU_IAR_GCC/main.c, /home/zwz/FreeRTOS/FreeRTOS/Demo/CORTEX_MPS2_QEMU_IAR_GCC/main_blinky.c
 */

#include "FreeRTOS.h"

#include "task.h"

#include "queue.h"

#include "semphr.h"

#include "timers.h"

// 本模板专用于 FreeRTOS CORTEX_MPS2_QEMU_IAR_GCC Demo（非 MPU 端口）
#include <stdio.h>
#include <stdlib.h>

// LibAFL集成必需的全局变量和函数
#define MAX_FUZZ_INPUT_SIZE 1024
__attribute__((used, visibility("default"))) unsigned char FUZZ_INPUT[MAX_FUZZ_INPUT_SIZE] = {
    // 默认种子：在修复阶段提供确定性输入，Fuzzer 运行时会覆盖此缓冲区
    0x46, 0x55, 0x5a, 0x5a, 0x01, 0x23, 0x45, 0x67,
    0x89, 0xab, 0xcd, 0xef, 0x11, 0x22, 0x33, 0x44,
    0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc,
    0xdd, 0xee, 0xff, 0x00, 0x13, 0x37, 0x42, 0x24,
    0x5a, 0xa5, 0xc3, 0x3c, 0xde, 0xed, 0xbe, 0xef,
    0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80,
    0x90, 0xa0, 0xb0, 0xc0, 0xd0, 0xe0, 0xf0, 0x0f,
    0x1f, 0x2f, 0x3f, 0x4f, 0x5f, 0x6f, 0x7f, 0x8f
};

// LibAFL断点函数
// 语义约定：一旦进入该函数，视为当前 harness 已经完成本轮测试，
// 该实现尽量触发一个可被 QEMU/调试器 捕获的软中断（bkpt），
// 然后在保底行为下结束进程以避免在未被调试器捕获时进入无限循环导致超时。
int __attribute__((noinline, used, visibility("default"))) BREAKPOINT(void)
{
    /* Issue a BKPT instruction to raise a trap that QEMU/LibAFL can observe. */
    __asm volatile ("bkpt #0\n\t");

    /*
     * If the bkpt is intercepted by the harness environment, that tool will
     * typically stop QEMU and record the run. If it is not intercepted for
     * some reason, instead of spinning forever (which causes harness timeouts),
     * explicitly terminate the process. This makes the harness deterministic
     * and avoids hangs when running under environments that do not forward
     * BKPT into the fuzzer harness.
     */
    fflush(stdout);
    /* Best-effort graceful termination. */
    exit(0);

    /* Not reachable, but keep a fallback infinite loop to satisfy compilers. */
    for (;;) { __asm volatile ("nop"); }
}

#define FUZZ_TASK_STACK_DEPTH (configMINIMAL_STACK_SIZE * 4)
static StackType_t xFuzzTaskStack[FUZZ_TASK_STACK_DEPTH];
static StaticTask_t xFuzzTaskTCB;
#define FUZZ_TASK_PRIORITY (tskIDLE_PRIORITY + 1)

// ====================================================================
// 测试用例辅助函数和全局变量（统一前缀 FR_*）
// ====================================================================
// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
#include <stdint.h>
#include <stddef.h>
#include <string.h>
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
/* Static storage and helper task used by the fuzz test. */
static StaticTask_t sec_task_tcb;
static StackType_t sec_task_stack[128];
static volatile UBaseType_t sec_ran_count = 0;
static TaskHandle_t sec_task_handle = NULL;

static void sec_task_func( void * pvParameters )
{
    /* Mark that this task ran at least once and suspend itself to avoid
     * continuous execution and to allow the test harness to delete it. */
    ( void ) pvParameters;
    sec_ran_count++;

    /* Suspend so it does not consume CPU in a tight loop. It will be deleted
     * by the main test logic when appropriate. */
    vTaskSuspend( NULL );

    /* If resume happens for some reason, park the task. */
    for( ;; )
    {
        vTaskDelay( 1 );
    }
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void *pvParameters)
{
    (void)pvParameters;

    // 测试用例: vTaskDelay_fuzz_case_1
    // API类别: task_management
    // 描述: Exercise vTaskDelay with small tick values, optionally creating a secondary task at same or lower priority to observe yielding behavior. Parameters are derived from FUZZ_INPUT via FR_* helpers. Uses only static FreeRTOS APIs and static storage. Asserts that a same-priority secondary task runs when vTaskDelay(0) is called.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        /*
         * If the scheduler isn't running we cannot safely call blocking RTOS
         * APIs. Instead of returning (which would make the harness hang waiting
         * for BREAKPOINT), we explicitly enter BREAKPOINT so the fuzzer harness
         * sees the test as completed for this input. This avoids timeout when
         * the environment calls test_task outside of a running scheduler.
         */
        printf("[ERROR] Scheduler not running - entering BREAKPOINT to terminate test\n");
        fflush(stdout);
        BREAKPOINT();
        return; /* unreachable, but keeps flow clear */
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        /* Reinitialize reader for this iteration (deterministic). */
        fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);
        /* Ensure at least 16 bytes are consumed as required by the harness policy. */
        (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

        /*
         * IMPORTANT SAFETY CHANGE:
         * The harness previously allowed non-zero tick values (0..3). On some
         * emulation/configurations the SysTick interrupt may not advance ticks
         * as expected which can cause vTaskDelay(n>0) to block indefinitely and
         * hang the harness. To avoid timeouts we only allow tick==0 here.
         * This still exercises the yielding behavior (vTaskDelay(0)).
         */
        TickType_t ticks = ( TickType_t ) FR_next_range(&fr, 0, 0 ); /* force 0 only */
        uint8_t create_secondary = ( uint8_t ) ( FR_next_u8(&fr) & 0x1 );
        uint8_t same_prio = ( uint8_t ) ( FR_next_u8(&fr) & 0x1 );
        uint32_t run_count = ( uint32_t ) FR_next_range(&fr, 1, 4 ); /* how many times to call vTaskDelay */

        /* Prepare / reset observation state. */
        sec_ran_count = 0;
        sec_task_handle = NULL;

        if( create_secondary )
        {
            UBaseType_t curr_prio = uxTaskPriorityGet( NULL );

            UBaseType_t sec_prio;
            if( same_prio )
            {
                sec_prio = curr_prio;
            }
            else
            {
                /* Try to make the secondary lower priority when possible. */
                sec_prio = ( curr_prio > tskIDLE_PRIORITY ) ? ( curr_prio - 1U ) : tskIDLE_PRIORITY;
            }

            /* Create the secondary task using the static API. */
            sec_task_handle = xTaskCreateStatic( sec_task_func,
                                                 "sec",
                                                 ( UBaseType_t ) 128,
                                                 NULL,
                                                 sec_prio,
                                                 sec_task_stack,
                                                 &sec_task_tcb );

            /* If creation failed, do not assert (assert may block); skip secondary. */
            if ( sec_task_handle == NULL )
            {
                printf("[WARN] sec_task creation failed, continuing without secondary\n");
                fflush(stdout);
            }
        }

        /* Call vTaskDelay the requested number of times. Keep ticks small to
         * avoid long sleeps in the harness. We forced ticks==0 above to avoid
         * dependence on the tick interrupt in the harness environment. */
        for( uint32_t k = 0U; k < run_count; ++k )
        {
            vTaskDelay( ticks );
        }

        /* If we created a same-priority secondary task and asked for a 0 tick delay,
         * vTaskDelay(0) should yield the processor, allowing another ready task of the
         * same priority to run. Instead of using configASSERT (which may halt the
         * system), report a warning to avoid blocking the harness in case the
         * environment cannot schedule the secondary task as expected. */
        if( create_secondary && ( ticks == 0U ) && ( same_prio != 0U ) && ( sec_task_handle != NULL ) )
        {
            if ( sec_ran_count == 0U ) {
                /* Report but do not assert to keep harness robust. */
                printf("[WARN] expected secondary task to run but sec_ran_count==0\n");
                fflush(stdout);
            }
        }

        /* Clean up: delete the secondary task if it was created. vTaskDelete works
         * for statically-created tasks as well. */
        if( create_secondary && ( sec_task_handle != NULL ) )
        {
            vTaskDelete( sec_task_handle );
            sec_task_handle = NULL;
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

// FreeRTOS任务包装器（非 MPU 端口，使用普通任务优先级）
void fuzz_task(void)
{
    // 创建模糊测试任务
    TaskHandle_t xHandle = xTaskCreateStatic(
        test_task,
        "FuzzTask",
        FUZZ_TASK_STACK_DEPTH,
        NULL,
        FUZZ_TASK_PRIORITY,
        xFuzzTaskStack,
        &xFuzzTaskTCB
    );

    if (xHandle == NULL) {
        printf("FuzzTask creation failed\n"); 
        fflush(stdout);
        configASSERT(0);
        for (;;) {
        }
    }

    vTaskStartScheduler();

    for (;;) {
    }
}
