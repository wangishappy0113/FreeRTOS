// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
#include <stdint.h>
#include <stddef.h>
#include <string.h>
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
#define NUM_WORKER_TASKS 2
#define WORKER_STACK_DEPTH 256
#define QUEUE_LENGTH_MAX 8
#define QUEUE_ITEM_SIZE sizeof(uint32_t)

/* Static storage for tasks, queues, and semaphores */
static StackType_t workerStacks[NUM_WORKER_TASKS][WORKER_STACK_DEPTH];
static StaticTask_t workerTCBs[NUM_WORKER_TASKS];
static uint8_t queueStorage[QUEUE_LENGTH_MAX * QUEUE_ITEM_SIZE];
static StaticQueue_t queueControlBlock;
static StaticSemaphore_t semaphoreControlBlock;

/* Shared state for verification between test_task and worker tasks */
static volatile uint32_t worker1_execution_count = 0;
static volatile uint32_t worker2_execution_count = 0;

/**
 * @brief Worker task that blocks waiting to receive an item from a queue.
 */
static void workerTask1(void *pvParameters)
{
    QueueHandle_t q = (QueueHandle_t)pvParameters;
    uint32_t received_val;
    for (;;)
    {
        if (xQueueReceive(q, &received_val, pdMS_TO_TICKS(20)) == pdPASS)
        {
            worker1_execution_count++;
        }
    }
}

/**
 * @brief Worker task that blocks waiting to take a binary semaphore.
 */
static void workerTask2(void *pvParameters)
{
    SemaphoreHandle_t s = (SemaphoreHandle_t)pvParameters;
    for (;;)
    {
        if (xSemaphoreTake(s, pdMS_TO_TICKS(20)) == pdPASS)
        {
            worker2_execution_count++;
        }
    }
}

// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: fuzz_task_and_queue_isr_operations
    // API类别: task_management
    // 描述: Fuzzes uxTaskGetNumberOfTasks by creating/deleting tasks and verifies its count throughout the lifecycle. Also fuzzes xQueueGenericSendFromISR and xQueueGiveFromISR by creating static tasks that block on a queue and a binary semaphore. The test logic, running in a privileged task, simulates an ISR context to send/give to these objects, waking the worker tasks. Fuzzer input determines the number of worker tasks, queue length, and queue send position (front, back, or overwrite). Asserts check task counts, successful ISR operations, and that worker tasks were correctly unblocked.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        /* Per-iteration variables */
        TaskHandle_t localWorkerHandles[NUM_WORKER_TASKS] = { NULL };
        QueueHandle_t localQueueHandle = NULL;
        SemaphoreHandle_t localSemaphoreHandle = NULL;

        /* Ensure there is enough fuzz data for a meaningful iteration */
        if (FR_remaining(&fr) < 20)
        {
            break;
        }

        /* Reset shared state for this test iteration */
        worker1_execution_count = 0;
        worker2_execution_count = 0;

        /* --- Get initial task count --- */
        UBaseType_t initial_task_count = uxTaskGetNumberOfTasks();
        /* Also test the MPU wrapper, which should return the same value */
        configASSERT(initial_task_count == MPU_uxTaskGetNumberOfTasksImpl());
        UBaseType_t expected_task_count = initial_task_count;

        /* --- Create tasks and kernel objects based on fuzzer input --- */
        UBaseType_t fuzz_priority = uxTaskPriorityGet(NULL);

        /* Decide how many worker tasks to create for this iteration */
        uint8_t num_tasks_to_create = FR_next_range(&fr, 0, NUM_WORKER_TASKS);

        if (num_tasks_to_create >= 1)
        {
            uint8_t q_len = FR_next_range(&fr, 1, QUEUE_LENGTH_MAX);
            localQueueHandle = xQueueCreateStatic(q_len, QUEUE_ITEM_SIZE, queueStorage, &queueControlBlock);
            configASSERT(localQueueHandle != NULL);

            /* Ensure worker task priority is less than the current task's priority */
            UBaseType_t priority = FR_next_range(&fr, tskIDLE_PRIORITY, fuzz_priority - 1);
            localWorkerHandles[0] = xTaskCreateStatic(workerTask1, "Worker1", WORKER_STACK_DEPTH, localQueueHandle, priority, workerStacks[0], &workerTCBs[0]);
            configASSERT(localWorkerHandles[0] != NULL);
            expected_task_count++;
        }

        if (num_tasks_to_create >= 2)
        {
            localSemaphoreHandle = xSemaphoreCreateBinaryStatic(&semaphoreControlBlock);
            configASSERT(localSemaphoreHandle != NULL);

            UBaseType_t priority = FR_next_range(&fr, tskIDLE_PRIORITY, fuzz_priority - 1);
            localWorkerHandles[1] = xTaskCreateStatic(workerTask2, "Worker2", WORKER_STACK_DEPTH, localSemaphoreHandle, priority, workerStacks[1], &workerTCBs[1]);
            configASSERT(localWorkerHandles[1] != NULL);
            expected_task_count++;
        }

        /* --- Verify task count after creation --- */
        configASSERT(uxTaskGetNumberOfTasks() == expected_task_count);

        /* Allow new tasks to run and block on their respective synchronization objects */
        vTaskDelay(pdMS_TO_TICKS(5));

        /* --- ISR Simulation: Call FromISR APIs --- */
        BaseType_t xHigherPriorityTaskWoken = pdFALSE;
        UBaseType_t uxSavedInterruptStatus;

        if (localQueueHandle != NULL)
        {
            uint32_t item_to_send = FR_next_u32(&fr);
            BaseType_t copy_pos;
            uint8_t pos_choice = FR_next_u8(&fr);
            UBaseType_t q_len = uxQueueSpacesAvailable(localQueueHandle) + uxQueueMessagesWaiting(localQueueHandle);

            if ((q_len == 1) && (pos_choice % 3 == 0)) {
                copy_pos = queueOVERWRITE;
            } else if (pos_choice % 2 == 0) {
                copy_pos = queueSEND_TO_BACK;
            } else {
                copy_pos = queueSEND_TO_FRONT;
            }

            uxSavedInterruptStatus = taskENTER_CRITICAL_FROM_ISR();
            BaseType_t send_result = xQueueGenericSendFromISR(localQueueHandle, &item_to_send, &xHigherPriorityTaskWoken, copy_pos);
            taskEXIT_CRITICAL_FROM_ISR(uxSavedInterruptStatus);
            configASSERT(send_result == pdPASS);
        }

        if (localSemaphoreHandle != NULL)
        {
            BaseType_t xWokenBySem = pdFALSE;
            uxSavedInterruptStatus = taskENTER_CRITICAL_FROM_ISR();
            BaseType_t give_result = xQueueGiveFromISR(localSemaphoreHandle, &xWokenBySem);
            taskEXIT_CRITICAL_FROM_ISR(uxSavedInterruptStatus);
            configASSERT(give_result == pdPASS);
            if (xWokenBySem) {
                xHigherPriorityTaskWoken = pdTRUE;
            }
        }

        /* In a real ISR, this would trigger a context switch if a higher priority task was unblocked */
        portYIELD_FROM_ISR(xHigherPriorityTaskWoken);

        /* --- Verification: Check if worker tasks executed --- */
        vTaskDelay(pdMS_TO_TICKS(5)); /* Allow time for unblocked tasks to run */

        if (localWorkerHandles[0] != NULL)
        {
            configASSERT(worker1_execution_count > 0);
        }
        if (localWorkerHandles[1] != NULL)
        {
            configASSERT(worker2_execution_count > 0);
        }

        /* --- Cleanup: Delete created tasks --- */
        for (int j = 0; j < num_tasks_to_create; j++)
        {
            if (localWorkerHandles[j] != NULL)
            {
                vTaskDelete(localWorkerHandles[j]);
                expected_task_count--;
            }
        }

        /* --- Final task count verification --- */
        configASSERT(uxTaskGetNumberOfTasks() == expected_task_count);
        configASSERT(MPU_uxTaskGetNumberOfTasksImpl() == initial_task_count);
    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

