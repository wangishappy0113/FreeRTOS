#define WORKER_TASK_STACK_DEPTH 256
static StackType_t ucWorkerTaskStack[WORKER_TASK_STACK_DEPTH];
static StaticTask_t xWorkerTaskTCB;
static TaskHandle_t xWorkerTaskHandle = NULL;

static StaticSemaphore_t xTestSemaphoreBuffer;
static SemaphoreHandle_t xTestSemaphore = NULL;

/* A simple worker task that waits on a semaphore. This allows us to
 * control its state (Blocked) from the main test task. */
static void worker_task_code(void *pvParameters)
{
    SemaphoreHandle_t semaphore = (SemaphoreHandle_t)pvParameters;
    for (;;)
    {
        /* Wait indefinitely for the semaphore. The test logic never gives it,
         * so this task remains in the Blocked state. */
        (void)xSemaphoreTake(semaphore, portMAX_DELAY);
    }
}

// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: fuzz_vTaskPrioritySet_comprehensive
    // API类别: task_management
    // 描述: Fuzzes vTaskPrioritySet by creating a helper 'worker' task and repeatedly changing either its own priority or the worker's priority. The fuzz input determines the target task (self or worker), the new priority (including out-of-range values to test capping), and the state of the worker task before the change (Ready/Blocked, Suspended, or Deleted). It verifies the priority is set correctly using uxTaskPriorityGet. The test for a deleted task handle is expected to trigger a configASSERT.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        /* This test requires the fuzz_task to be privileged to call vTaskPrioritySet. */
        FR_Reader fr;
        FR_init(&fr, FUZZ_INPUT, FUZZ_INPUT_SIZE);

        /* Create a binary semaphore for the worker task to block on. */
        xTestSemaphore = xSemaphoreCreateBinaryStatic(&xTestSemaphoreBuffer);
        configASSERT(xTestSemaphore != NULL);

        /* The worker task will run at a lower priority than the test task to ensure
         * the test task remains in control. */
        UBaseType_t worker_priority = (FUZZ_TASK_PRIORITY > 1) ? (FUZZ_TASK_PRIORITY - 1) : 0;
        xWorkerTaskHandle = xTaskCreateStatic(
            worker_task_code,
            "Worker",
            WORKER_TASK_STACK_DEPTH,
            (void *)xTestSemaphore,
            worker_priority,
            ucWorkerTaskStack,
            &xWorkerTaskTCB
        );
        configASSERT(xWorkerTaskHandle != NULL);

        /* Loop to execute multiple test scenarios from the same fuzz input. */
        for (int i = 0; i < 50; ++i)
        {
            /* Need at least 3 bytes for one full iteration. */
            if (FR_remaining(&fr) < 3)
            {
                break;
            }

            uint8_t target_selector = FR_next_u8(&fr);
            /* Generate priority, including values outside the valid range to test capping. */
            UBaseType_t new_priority = (UBaseType_t)FR_next_u8(&fr) % (configMAX_PRIORITIES + 2);
            uint8_t worker_pre_state_selector = FR_next_u8(&fr);

            TaskHandle_t target_handle;
            TaskHandle_t handle_to_check;

            if ((target_selector % 2) == 0)
            {
                /* Target the current task (fuzz_task) */
                target_handle = NULL;
                handle_to_check = xTaskGetCurrentTaskHandle();
            }
            else
            {
                /* Target the worker task */
                target_handle = xWorkerTaskHandle;
                handle_to_check = xWorkerTaskHandle;

                if (handle_to_check == NULL)
                {
                    /* Worker was deleted in a previous iteration, cannot continue. */
                    break;
                }

                /* Set the worker task into a specific state based on fuzz input */
                if (eTaskGetState(handle_to_check) == eSuspended)
                {
                    vTaskResume(handle_to_check); /* Reset state from previous iteration */
                }

                /* 0 = Ready/Blocked, 1 = Suspended, 2 = Deleted */
                uint8_t desired_state = worker_pre_state_selector % 3;

                if (desired_state == 1) /* Suspended */
                {
                    vTaskSuspend(handle_to_check);
                }
                else if (desired_state == 2) /* Deleted */
                {
                    /* Destructive test: call API on a stale handle. This should assert. */
                    vTaskDelete(handle_to_check);
                    vTaskPrioritySet(handle_to_check, new_priority);
            
                    /* The assert should have fired. If not, mark handle as invalid and break. */
                    xWorkerTaskHandle = NULL;
                    break;
                }
            }
    
            /* If we are here, the target handle is valid for a priority set operation. */
            vTaskPrioritySet(target_handle, new_priority);

            UBaseType_t actual_new_priority = uxTaskPriorityGet(handle_to_check);
            UBaseType_t expected_priority = new_priority;

            if (expected_priority >= configMAX_PRIORITIES)
            {
                expected_priority = configMAX_PRIORITIES - 1;
            }

            configASSERT(actual_new_priority == expected_priority);
    
            /* A small delay can allow the scheduler to run if a higher priority task was readied. */
            vTaskDelay(1);
        }

        /* Cleanup: If the worker task still exists, delete it. */
        if (xWorkerTaskHandle != NULL)
        {
            if(eTaskGetState(xWorkerTaskHandle) == eSuspended)
            {
                vTaskResume(xWorkerTaskHandle);
            }
            vTaskDelete(xWorkerTaskHandle);
            xWorkerTaskHandle = NULL;
        }
    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

