    }
}

// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: vTaskAllocateMPURegions_Fuzz
    // API类别: task_management
    // 描述: Fuzzes the MPU region allocation by dynamically reconfiguring memory access for both the current task and a secondary static worker task. It utilizes a strictly aligned 2KB buffer to derive valid MPU base addresses and sizes, ensuring compatibility with Cortex-M MPU alignment rules. The test exercises various MPU parameters and targets (self vs other task) to validate kernel stability during runtime protection changes.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        if( !fr_inited )
        {
            FR_init( &fr, FUZZ_INPUT, sizeof( FUZZ_INPUT ) );
            fr_inited = 1;
        }

        if( xWorkerHandle == NULL )
        {
            /* Create a secondary task to receive MPU modifications. Set priority below the harness task. */
            UBaseType_t uxWorkerPriority = ( FUZZ_TASK_PRIORITY > 0 ) ? ( FUZZ_TASK_PRIORITY - 1 ) : 0;
            xWorkerHandle = xTaskCreateStatic( vWorkerTask, "Worker", configMINIMAL_STACK_SIZE, NULL, uxWorkerPriority, uxWorkerStack, &xWorkerTCB );
        }

        configASSERT( xWorkerHandle != NULL );

        /* Ensure enough bytes remain for at least one full configuration set (approx 12-16 bytes) */
        if( FR_remaining( &fr ) < 32 )
        {
            return;
        }

        MemoryRegion_t xRegions[ portNUM_CONFIGURABLE_REGIONS ];
        memset( xRegions, 0, sizeof( xRegions ) );

        for( int i = 0; i < portNUM_CONFIGURABLE_REGIONS; i++ )
        {
            /* MPU size must be a power of 2. We use 2^5 (32) to 2^10 (1024) bytes. */
            uint8_t pwr = FR_next_range( &fr, 5, 10 );
            uint32_t ulSize = ( 1UL << pwr );
    
            /* Alignment must match size. We sub-divide the 2KB pre-aligned buffer. */
            uint32_t ulMaxBlocks = 2048 / ulSize;
            uint32_t ulBlockIdx = FR_next_u8( &fr ) % ulMaxBlocks;
    
            xRegions[ i ].pvBaseAddress = ( void * ) ( ucMPUBuffer + ( ulBlockIdx * ulSize ) );
            xRegions[ i ].ulLengthInBytes = ulSize;

            /* Map fuzzed byte to a selection of valid MPU parameters */
            uint32_t ulPossibleParams[] = {
                portMPU_REGION_READ_WRITE,
                portMPU_REGION_READ_ONLY,
                portMPU_REGION_PRIVILEGED_READ_WRITE,
                portMPU_REGION_PRIVILEGED_READ_ONLY,
                portMPU_REGION_READ_WRITE | portMPU_REGION_EXECUTE_NEVER,
                portMPU_REGION_READ_ONLY | portMPU_REGION_CACHEABLE_BUFFERABLE
            };
            xRegions[ i ].ulParameters = ulPossibleParams[ FR_next_u8( &fr ) % 6 ];
        }

        /* Decide target task: NULL (calling task) or the specific worker task handle */
        TaskHandle_t xTarget = ( FR_next_u8( &fr ) % 2 == 0 ) ? NULL : xWorkerHandle;

        /* Re-allocate MPU regions for the target task */
        vTaskAllocateMPURegions( xTarget, xRegions );

        /* Trigger a context switch to allow the MPU hardware configuration to take effect if self-modifying */
        vTaskDelay( pdMS_TO_TICKS( 1 ) );
    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

