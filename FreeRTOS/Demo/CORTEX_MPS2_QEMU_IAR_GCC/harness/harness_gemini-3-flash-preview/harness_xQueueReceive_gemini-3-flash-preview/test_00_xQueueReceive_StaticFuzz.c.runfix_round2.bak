#include "FreeRTOS.h"
#include "task.h"
#include "queue.h"
#include "semphr.h"
#include "timers.h"
#include <stdio.h>
#include <stdint.h>
#include <stddef.h>
#include <string.h>

#define MAX_FUZZ_INPUT_SIZE 1024
__attribute__((used, visibility("default"))) unsigned char FUZZ_INPUT[MAX_FUZZ_INPUT_SIZE] = {
    0x46, 0x55, 0x5a, 0x5a, 0x01, 0x23, 0x45, 0x67,
    0x89, 0xab, 0xcd, 0xef, 0x11, 0x22, 0x33, 0x44,
    0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc,
    0xdd, 0xee, 0xff, 0x00, 0x13, 0x37, 0x42, 0x24,
    0x5a, 0xa5, 0xc3, 0x3c, 0xde, 0xed, 0xbe, 0xef,
    0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80,
    0x90, 0xa0, 0xb0, 0xc0, 0xd0, 0xe0, 0xf0, 0x0f,
    0x1f, 0x2f, 0x3f, 0x4f, 0x5f, 0x6f, 0x7f, 0x8f
};

int __attribute__((noinline, used, visibility("default"))) BREAKPOINT(void)
{
    for (;;) {
        __asm volatile("nop");
    }
}

#define FUZZ_TASK_STACK_DEPTH (configMINIMAL_STACK_SIZE * 4)
static StackType_t xFuzzTaskStack[FUZZ_TASK_STACK_DEPTH];
static StaticTask_t xFuzzTaskTCB;
#define FUZZ_TASK_PRIORITY (tskIDLE_PRIORITY + 1)

typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;

#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    if (r->off + 4 <= r->size) {
        uint32_t val; memcpy(&val, r->data + r->off, 4); r->off += 4; return val;
    }
    return 0;
}
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    return min_v + (FR_next_u32(r) % (max_v - min_v + 1u));
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}

/* Use static buffers but ensure they are fresh and aligned to avoid crashes and assertions */
static StaticQueue_t xStaticQueue;
static uint8_t ucQueueStorage[160] __attribute__((aligned(4)));
static uint8_t ucReceiveBuf[32] __attribute__((aligned(4)));
static uint8_t ucSendBuf[32] __attribute__((aligned(4)));

void __attribute__((used, visibility("default"))) test_task(void)
{
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    /* Consume baseline bytes */
    unsigned char fr_baseline[16];
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        return;
    }

    /* Define parameters outside the loop to ensure the queue remains consistent for this fuzz run */
    if (FR_remaining(&fr) < 12) {
        printf("[TEST_CASE_COMPLETED]\n");
        BREAKPOINT();
        return;
    }

    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);
    uint8_t ucItemSize = (uint8_t)FR_next_range(&fr, 0, 16);
    UBaseType_t uxQueueLength = (UBaseType_t)FR_next_range(&fr, 1, 10);

    /* Create the queue once for this specific set of fuzzed parameters */
    QueueHandle_t xFuzzQueue = xQueueCreateStatic(uxQueueLength, (UBaseType_t)ucItemSize, ucQueueStorage, &xStaticQueue);

    if (xFuzzQueue != NULL) {
        for (unsigned int i = 0; i < iterations; ++i) {
            if (FR_remaining(&fr) < 1) break;
            uint8_t action = FR_next_u8(&fr);

            if (action % 2 == 0) {
                /* Case: Send - Check if enough data remains to populate the buffer */
                if (FR_remaining(&fr) >= (size_t)ucItemSize) {
                    if (ucItemSize > 0) {
                        FR_next_bytes(&fr, ucSendBuf, ucItemSize);
                    }
                    /* Ensure pvBuffer is only NULL if item size is 0 to satisfy configASSERT in GenericSend */
                    void * const pvItem = (ucItemSize > 0) ? (void *)ucSendBuf : NULL;
                    ( void ) xQueueSend(xFuzzQueue, pvItem, (TickType_t)0);
                } else {
                    break;
                }
            } else {
                /* Case: Receive - Check if enough data for TickType_t parameter */
                if (FR_remaining(&fr) < 4) break;
                TickType_t xTicksToWait = (TickType_t)FR_next_range(&fr, 0, 10);
    
                /* Ensure pvBuffer is only NULL if item size is 0 to satisfy configASSERT in GenericReceive */
                void * const pvBuffer = (ucItemSize > 0) ? (void *)ucReceiveBuf : NULL;
                ( void ) xQueueReceive(xFuzzQueue, pvBuffer, xTicksToWait);
            }
        }
    }

    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);
    BREAKPOINT();
}

void fuzz_task(void)
{
    TaskHandle_t xHandle = xTaskCreateStatic(
        test_task,
        "FuzzTask",
        FUZZ_TASK_STACK_DEPTH,
        NULL,
        FUZZ_TASK_PRIORITY,
        xFuzzTaskStack,
        &xFuzzTaskTCB
    );

    if (xHandle == NULL) {
        printf("FuzzTask creation failed\n"); 
        fflush(stdout);
        configASSERT(0);
        for (;;) {}
    }

    vTaskStartScheduler();
    for (;;) {}
}
