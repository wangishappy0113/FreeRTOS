#include "FreeRTOS.h"

#include "task.h"

#include "queue.h"

#include "semphr.h"

#include "timers.h"

// 本模板专用于 FreeRTOS CORTEX_MPS2_QEMU_IAR_GCC Demo（非 MPU 端口）
#include <stdio.h>

// LibAFL集成必需的全局变量和函数
#define MAX_FUZZ_INPUT_SIZE 1024
__attribute__((used, visibility("default"))) unsigned char FUZZ_INPUT[MAX_FUZZ_INPUT_SIZE] = {
    // 默认种子：在修复阶段提供确定性输入，Fuzzer 运行时会覆盖此缓冲区
    0x46, 0x55, 0x5a, 0x5a, 0x01, 0x23, 0x45, 0x67,
    0x89, 0xab, 0xcd, 0xef, 0x11, 0x22, 0x33, 0x44,
    0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc,
    0xdd, 0xee, 0xff, 0x00, 0x13, 0x37, 0x42, 0x24,
    0x5a, 0xa5, 0xc3, 0x3c, 0xde, 0xed, 0xbe, 0xef,
    0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80,
    0x90, 0xa0, 0xb0, 0xc0, 0xd0, 0xe0, 0xf0, 0x0f,
    0x1f, 0x2f, 0x3f, 0x4f, 0x5f, 0x6f, 0x7f, 0x8f
};

// LibAFL断点函数
// 语义约定：一旦进入该函数，视为当前 harness 已经完成本轮测试，
// 不再返回调用者，而是在一个可控的自旋循环中停住，由 QEMU/LibAFL 捕获。
int __attribute__((noinline, used, visibility("default"))) BREAKPOINT(void)
{
    for (;;) {
        __asm volatile("nop");
    }
}

#define FUZZ_TASK_STACK_DEPTH (configMINIMAL_STACK_SIZE * 4)
static StackType_t xFuzzTaskStack[FUZZ_TASK_STACK_DEPTH];
static StaticTask_t xFuzzTaskTCB;
#define FUZZ_TASK_PRIORITY (tskIDLE_PRIORITY + 1)

// ====================================================================
// 测试用例辅助函数和全局变量（统一前缀 FR_*）
// ====================================================================
// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
#include <stdint.h>
#include <stddef.h>
#include <string.h>
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
typedef struct
{
    StaticTask_t tcb;
    StackType_t stack[256];
    TaskHandle_t handle;
} FuzzStaticTaskSlot_t;

#define FUZZ_MAX_TASKS 4

static FuzzStaticTaskSlot_t g_taskSlots[FUZZ_MAX_TASKS];
static UBaseType_t g_createdTasks = 0;

static void fuzz_worker_task(void *pvParameters)
{
    /* Do a small amount of deterministic work based on the parameter to
     * consume some stack and exercise different code paths, but always
     * terminate quickly so the fuzz harness can continue. */
    uint32_t pattern = (uint32_t) pvParameters;
    volatile uint32_t acc = 0;
    /* Bound the loop to keep execution time small. */
    uint32_t iterations = (pattern & 0xFFu) + 1u;
    if (iterations > 64u)
    {
        iterations = 64u;
    }
    for (uint32_t i = 0; i < iterations; i++)
    {
        acc ^= (pattern + i);
    }
    (void) acc;
    vTaskDelete(NULL);
}

static void fuzz_init_task_slots_once(void)
{
    /* Ensure slots are marked empty on first use. This function is idempotent
     * because g_createdTasks only ever increases and slots are only written
     * when a task is created. */
    static BaseType_t initialized = pdFALSE;
    if (initialized == pdFALSE)
    {
        for (UBaseType_t i = 0; i < FUZZ_MAX_TASKS; i++)
        {
            g_taskSlots[i].handle = NULL;
        }
        g_createdTasks = 0;
        initialized = pdTRUE;
    }
}

static TaskHandle_t fuzz_create_static_task_from_fuzz(uint8_t stackSelector,
                                                      uint8_t prioSelector,
                                                      uint32_t paramPattern)
{
    if (g_createdTasks >= FUZZ_MAX_TASKS)
    {
        return NULL;
    }

    /* Map selector to a stack depth between 64 and 256 words. */
    UBaseType_t minDepth = 64u;
    UBaseType_t maxDepth = 256u;
    UBaseType_t depthRange = maxDepth - minDepth + 1u;
    UBaseType_t stackDepth = minDepth + (UBaseType_t) (stackSelector % depthRange);

    /* Clamp to the static buffer size. */
    if (stackDepth > (UBaseType_t) (sizeof(g_taskSlots[0].stack) / sizeof(StackType_t)))
    {
        stackDepth = (UBaseType_t) (sizeof(g_taskSlots[0].stack) / sizeof(StackType_t));
    }

    /* Map selector to a priority within valid range. Assume configMAX_PRIORITIES
     * is available and at least 1. */
    UBaseType_t maxPrio = (UBaseType_t) (configMAX_PRIORITIES - 1U);
    UBaseType_t priority = (UBaseType_t) (prioSelector % (maxPrio + 1U));

    FuzzStaticTaskSlot_t *slot = &g_taskSlots[g_createdTasks];

    TaskHandle_t handle = xTaskCreateStatic(
        fuzz_worker_task,
        "fuzzW",
        stackDepth,
        (void *) paramPattern,
        priority,
        slot->stack,
        &slot->tcb);

    /* xTaskCreateStatic must succeed if parameters are valid; assert handle. */
    configASSERT(handle != NULL);

    slot->handle = handle;
    g_createdTasks++;

    return handle;
}

static TaskHandle_t fuzz_select_existing_task(uint8_t selector)
{
    if (g_createdTasks == 0)
    {
        return NULL;
    }
    UBaseType_t index = (UBaseType_t) (selector % g_createdTasks);
    return g_taskSlots[index].handle;
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: uxTaskGetStackHighWaterMark_fuzz_basic
    // API类别: task_management
    // 描述: Fuzzes uxTaskGetStackHighWaterMark by creating a mix of static tasks with varying stack sizes and priorities, then querying stack high water marks using NULL (self) and selected task handles derived from fuzz input. Exercises both idle-like and active tasks and validates return values are within stack bounds.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            /* Ensure global task slots are initialized once. */
            fuzz_init_task_slots_once();

            /* We need at least 16 bytes per iteration to derive parameters. If not
             * enough bytes remain, exit the loop early. */
            if (FR_remaining(&fr) < 16u)
            {
                break;
            }

            /* Derive parameters from fuzz input. */
            uint8_t createFlag = FR_next_u8(&fr);
            uint8_t stackSel   = FR_next_u8(&fr);
            uint8_t prioSel    = FR_next_u8(&fr);
            uint8_t paramByte  = FR_next_u8(&fr);

            uint8_t queryMode  = FR_next_u8(&fr); /* 0: self, 1: specific handle, 2: NULL even if not self */
            uint8_t handleSel  = FR_next_u8(&fr);

            /* Consume additional bytes to vary the worker parameter pattern. */
            uint32_t extra1 = FR_next_u32(&fr);
            uint32_t extra2 = FR_next_u32(&fr);

            uint32_t paramPattern = ((uint32_t) paramByte) ^ (extra1 + (extra2 << 1));

            /* Optionally create a new static task based on fuzz input. */
            if ((createFlag & 0x1u) != 0u)
            {
                (void) fuzz_create_static_task_from_fuzz(stackSel, prioSel, paramPattern);
            }

            /* Decide which task handle to query. */
            TaskHandle_t targetHandle = NULL;

            switch (queryMode % 3u)
            {
                case 0u:
                    /* Query self using NULL. */
                    targetHandle = NULL;
                    break;

                case 1u:
                    /* Query a specific existing task handle if any. */
                    targetHandle = fuzz_select_existing_task(handleSel);
                    break;

                case 2u:
                default:
                    /* Explicitly choose between NULL and an existing handle. */
                    if ((handleSel & 0x1u) == 0u)
                    {
                        targetHandle = NULL;
                    }
                    else
                    {
                        targetHandle = fuzz_select_existing_task(handleSel);
                    }
                    break;
            }

            /* Call uxTaskGetStackHighWaterMark with the chosen handle. If there are no
             * created tasks and targetHandle is non-NULL, the implementation will
             * assert; avoid that by forcing NULL in that case. */
            if ((targetHandle != NULL) && (g_createdTasks == 0u))
            {
                targetHandle = NULL;
            }

            UBaseType_t highWater = uxTaskGetStackHighWaterMark(targetHandle);

            /* Basic sanity check: high water mark should not exceed the maximum stack
             * depth we ever allocate (256 words). This is a defensive check on the
             * API result, not a strict requirement, so just assert within expected
             * bounds. */
            configASSERT(highWater <= 256u);

            /* No explicit cleanup here: worker tasks delete themselves, and the fuzz
             * harness will eventually end the scheduler or reset between runs. */
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

// FreeRTOS任务包装器（非 MPU 端口，使用普通任务优先级）
void fuzz_task(void)
{
    // 创建模糊测试任务
    TaskHandle_t xHandle = xTaskCreateStatic(
        test_task,
        "FuzzTask",
        FUZZ_TASK_STACK_DEPTH,
        NULL,
        FUZZ_TASK_PRIORITY,
        xFuzzTaskStack,
        &xFuzzTaskTCB
    );

    if (xHandle == NULL) {
        printf("FuzzTask creation failed\n"); 
        fflush(stdout);
        configASSERT(0);
        for (;;) {
        }
    }

    vTaskStartScheduler();

    for (;;) {
    }
}