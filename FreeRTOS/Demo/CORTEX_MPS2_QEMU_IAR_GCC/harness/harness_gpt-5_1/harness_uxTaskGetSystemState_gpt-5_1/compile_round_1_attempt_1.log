ype_t uxDepth )\n{\n    if( uxDepth == 0U )\n    {\n        return;\n    }\n\n    if( uxDepth > 4U )\n    {\n        uxDepth = 4U;\n    }\n\n    for( UBaseType_t i = 0; i < uxDepth; i++ )\n    {\n        vTaskSuspendAll();\n    }\n\n    for( UBaseType_t i = 0; i < uxDepth; i++ )\n    {\n        ( void ) xTaskResumeAll();\n    }\n}\n
