// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: vStreamBufferDelete_static_handle_fuzz
    // API类别: stream_buffer
    // 描述: Fuzz vStreamBufferDelete using statically allocated stream buffers and varied delete patterns, including repeated deletes and interleaved send/receive operations.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            /* Each iteration consumes additional fuzz input and manipulates stream buffers
             * before calling vStreamBufferDelete in different patterns. */

            /* Ensure we have enough bytes to drive at least one meaningful operation. */
            if( FR_remaining( &fr ) < 16U )
            {
                break;
            }

            /* Decide what to do this iteration. */
            uint8_t action = FR_next_u8( &fr );

            switch( action % 3U )
            {
                case 0:
                {
                    /* Create a new static stream buffer, exercise it, then delete it once. */
                    BaseType_t useFirst = ( ( FR_next_u8( &fr ) & 0x01U ) != 0U ) ? pdTRUE : pdFALSE;
                    StreamBufferHandle_t h = helper_create_static_stream( &fr, useFirst );

                    if( h != NULL )
                    {
                        helper_exercise_stream( &fr, h );
                        vStreamBufferDelete( h );

                        /* After delete, do not use h again in this branch. */
                    }
                    break;
                }

                case 1:
                {
                    /* Create and track a stream buffer, possibly delete a previously tracked one. */
                    BaseType_t useFirst = ( ( FR_next_u8( &fr ) & 0x01U ) != 0U ) ? pdTRUE : pdFALSE;
                    StreamBufferHandle_t hNew = helper_create_static_stream( &fr, useFirst );

                    if( hNew != NULL )
                    {
                        helper_exercise_stream( &fr, hNew );
                        helper_track_stream( &fr, hNew );
                    }

                    /* Optionally delete a tracked stream (may be NULL or already deleted). */
                    StreamBufferHandle_t hOld = helper_pick_tracked_stream( &fr );
                    if( hOld != NULL )
                    {
                        vStreamBufferDelete( hOld );

                        /* Clear the slot if we can identify which one it was. */
                        for( size_t i = 0; i < MAX_TRACKED_STREAMS; i++ )
                        {
                            if( g_trackedStreams[ i ] == hOld )
                            {
                                g_trackedStreams[ i ] = NULL;
                                break;
                            }
                        }
                    }
                    break;
                }

                case 2:
                default:
                {
                    /* Attempt to delete arbitrary handles, including NULL or stale ones,
                     * to exercise robustness of vStreamBufferDelete's assertions. */

                    /* Pick a tracked handle (may be NULL). */
                    StreamBufferHandle_t hTracked = helper_pick_tracked_stream( &fr );

                    /* Also construct a possibly-invalid handle value from fuzz data. */
                    if( FR_remaining( &fr ) < 4U )
                    {
                        break;
                    }

                    uint32_t rawPtr = FR_next_u32( &fr );
                    StreamBufferHandle_t hFuzz = ( StreamBufferHandle_t ) ( uintptr_t ) rawPtr;

                    uint8_t which = FR_next_u8( &fr );

                    StreamBufferHandle_t target = NULL;
                    switch( which % 3U )
                    {
                        case 0:
                            target = hTracked;
                            break;
                        case 1:
                            target = NULL;
                            break;
                        case 2:
                        default:
                            target = hFuzz;
                            break;
                    }

                    /* Only call delete if target is non-NULL to avoid trivial asserts on NULL. */
                    if( target != NULL )
                    {
                        vStreamBufferDelete( target );
                    }
                    break;
                }
            }
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

