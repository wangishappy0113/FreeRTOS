#include <stdint.h>
#include <stddef.h>
#include <string.h>
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
static StaticStreamBuffer_t g_staticStreamBuf1;
static StaticStreamBuffer_t g_staticStreamBuf2;

/* Backing storage for the static stream buffers. Sizes are fixed upper bounds; actual
 * sizes used per-iteration are derived from fuzz input but clamped to these arrays. */
#define TEST_STREAM_STORAGE_SIZE1 128U
#define TEST_STREAM_STORAGE_SIZE2 96U
static uint8_t g_streamStorage1[ TEST_STREAM_STORAGE_SIZE1 ];
static uint8_t g_streamStorage2[ TEST_STREAM_STORAGE_SIZE2 ];

/* Simple holder for a small set of stream buffer handles that can be reused
 * across iterations to exercise delete-after-use and double-delete scenarios. */
#define MAX_TRACKED_STREAMS 4
static StreamBufferHandle_t g_trackedStreams[ MAX_TRACKED_STREAMS ] = { 0 };

/* Helper to create a static stream buffer with fuzz-controlled size and trigger level.
 * Returns NULL on failure. All parameters are derived from the FR_Reader. */
static StreamBufferHandle_t helper_create_static_stream( FR_Reader * fr,
                                                         BaseType_t useFirstStorage )
{
    if( fr == NULL )
    {
        return NULL;
    }

    /* Need at least 3 bytes: 2 for size, 1 for trigger level fraction. */
    if( FR_remaining( fr ) < 3U )
    {
        return NULL;
    }

    uint16_t rawSize = FR_next_u16( fr );
    uint8_t trigFrac = FR_next_u8( fr );

    uint8_t * pStorage = NULL;
    size_t storageCap = 0U;
    StaticStreamBuffer_t * pStatic = NULL;

    if( useFirstStorage != pdFALSE )
    {
        pStorage = g_streamStorage1;
        storageCap = TEST_STREAM_STORAGE_SIZE1;
        pStatic = &g_staticStreamBuf1;
    }
    else
    {
        pStorage = g_streamStorage2;
        storageCap = TEST_STREAM_STORAGE_SIZE2;
        pStatic = &g_staticStreamBuf2;
    }

    /* Map rawSize into [1, storageCap]. Ensure non-zero length. */
    size_t bufferSize = ( ( size_t ) ( rawSize % storageCap ) ) + 1U;

    /* Trigger level as a fraction of bufferSize. */
    size_t triggerLevel = 0U;
    if( bufferSize > 0U )
    {
        triggerLevel = ( ( size_t ) trigFrac * bufferSize ) / 255U;
        if( triggerLevel > bufferSize )
        {
            triggerLevel = bufferSize;
        }
    }

    StreamBufferHandle_t h = xStreamBufferCreateStatic( bufferSize,
                                                        triggerLevel,
                                                        pStorage,
                                                        pStatic );
    return h;
}

/* Store a handle into the tracked array at a fuzz-chosen index. */
static void helper_track_stream( FR_Reader * fr, StreamBufferHandle_t h )
{
    if( ( fr == NULL ) || ( h == NULL ) )
    {
        return;
    }

    if( FR_remaining( fr ) < 1U )
    {
        return;
    }

    uint8_t idx = FR_next_u8( fr );
    idx = ( uint8_t ) ( idx % MAX_TRACKED_STREAMS );
    g_trackedStreams[ idx ] = h;
}

/* Select a tracked stream handle based on fuzz input. May return NULL. */
static StreamBufferHandle_t helper_pick_tracked_stream( FR_Reader * fr )
{
    if( fr == NULL )
    {
        return NULL;
    }

    if( FR_remaining( fr ) < 1U )
    {
        return NULL;
    }

    uint8_t idx = FR_next_u8( fr );
    idx = ( uint8_t ) ( idx % MAX_TRACKED_STREAMS );
    return g_trackedStreams[ idx ];
}

/* Perform some basic send/receive operations on a stream buffer using fuzz-derived
 * sizes and data. This is used to put the stream buffer into non-trivial states
 * before deletion. */
static void helper_exercise_stream( FR_Reader * fr, StreamBufferHandle_t h )
{
    if( ( fr == NULL ) || ( h == NULL ) )
    {
        return;
    }

    /* Need at least a few bytes to drive operations. */
    if( FR_remaining( fr ) < 4U )
    {
        return;
    }

    uint8_t opMask = FR_next_u8( fr );
    uint8_t sendLenRaw = FR_next_u8( fr );
    uint8_t recvLenRaw = FR_next_u8( fr );
    uint8_t pattern = FR_next_u8( fr );

    size_t maxChunk = 32U;
    size_t sendLen = ( size_t ) ( sendLenRaw % ( maxChunk + 1U ) );
    size_t recvLen = ( size_t ) ( recvLenRaw % ( maxChunk + 1U ) );

    uint8_t sendBuf[ 32 ];
    uint8_t recvBuf[ 32 ];

    for( size_t i = 0; i < sendLen; i++ )
    {
        sendBuf[ i ] = ( uint8_t ) ( pattern + ( uint8_t ) i );
    }

    if( ( opMask & 0x01U ) != 0U )
    {
        ( void ) xStreamBufferSend( h,
                                    sendBuf,
                                    sendLen,
                                    0U );
    }

    if( ( opMask & 0x02U ) != 0U )
    {
        ( void ) xStreamBufferReceive( h,
                                       recvBuf,
                                       recvLen,
                                       0U );
    }
}


