// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
#include <stdint.h>
#include <stddef.h>
#include <string.h>
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
/* Static storage for a restricted task and its stack. */
#ifndef TEST_TASK_STACK_SIZE
#define TEST_TASK_STACK_SIZE 256U
#endif

/* Provide a couple of statically allocated buffers that can be used as MPU regions. */
__attribute__((aligned(128))) static uint8_t ucRegionBuf1[128];
__attribute__((aligned(256))) static uint8_t ucRegionBuf2[256];

/* Static TCB and stack for the restricted task. */
static StaticTask_t xRestrictedTCB;
static StackType_t xRestrictedStack[ TEST_TASK_STACK_SIZE ];

/* Handle for the restricted task. */
static TaskHandle_t xRestrictedTaskHandle = NULL;

/* Flag to ensure the restricted task is created only once across iterations. */
static BaseType_t xRestrictedTaskCreated = pdFALSE;

/* Simple restricted task function; it just yields occasionally. */
static void vRestrictedTask( void * pvParameters )
{
    ( void ) pvParameters;

    /* Do a small amount of work then return so the scheduler can switch. */
    taskYIELD();

    /* Delete self to keep lifecycle complete if ever scheduled again. */
    vTaskDelete( NULL );
}

/* Helper to lazily create a restricted task with some initial MPU regions. */
static void prvEnsureRestrictedTaskCreated( void )
{
#if ( configENABLE_MPU == 1 ) || defined( portUSING_MPU_WRAPPERS )
    if( xRestrictedTaskCreated == pdFALSE )
    {
        /* Define three regions as required by MPU ports (portNUM_CONFIGURABLE_REGIONS is typically 3). */
        static const MemoryRegion_t xInitialRegions[ portNUM_CONFIGURABLE_REGIONS ] =
        {
            { ucRegionBuf1, sizeof( ucRegionBuf1 ), portMPU_REGION_READ_WRITE },
            { ucRegionBuf2, sizeof( ucRegionBuf2 ), portMPU_REGION_READ_ONLY },
            { 0,           0,                      0 }
        };

        TaskParameters_t xParams;
        memset( &xParams, 0, sizeof( xParams ) );

        xParams.pvTaskCode   = vRestrictedTask;
        xParams.pcName       = "RTask";
        xParams.usStackDepth = TEST_TASK_STACK_SIZE;
        /* Give it a low but valid priority. */
        xParams.uxPriority   = ( tskIDLE_PRIORITY + 1 ) | portPRIVILEGE_BIT;
        xParams.pvParameters = NULL;
        xParams.puxStackBuffer = xRestrictedStack;

        /* Copy initial regions into the parameter structure. */
        for( size_t i = 0; i < portNUM_CONFIGURABLE_REGIONS; i++ )
        {
            xParams.xRegions[ i ] = xInitialRegions[ i ];
        }

        xRestrictedTaskHandle = xTaskCreateRestrictedStatic( &xParams, &xRestrictedTCB );
        configASSERT( xRestrictedTaskHandle != NULL );

        xRestrictedTaskCreated = pdTRUE;
    }
#else
    /* On non-MPU builds this helper should not be used. */
    ( void ) vRestrictedTask;
    ( void ) xRestrictedTaskHandle;
    ( void ) xRestrictedTaskCreated;
#endif
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: vTaskAllocateMPURegions_basic_fuzz
    // API类别: task_management
    // 描述: Fuzz vTaskAllocateMPURegions by creating a restricted task with static MPU regions, then repeatedly reallocating MPU regions for either the created task or the calling task using parameters derived from FUZZ_INPUT.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            /* Ensure we have a restricted task available once. */
            prvEnsureRestrictedTaskCreated();

            /* We need enough bytes to derive several parameters. If not, exit loop. */
            if( FR_remaining( &fr ) < 16 )
            {
                break;
            }

            /* Decide whether to target the restricted task or the calling task (NULL). */
            uint8_t targetSel;
            if( FR_next_u8( &fr, &targetSel ) != 0 )
            {
                break;
            }

            TaskHandle_t xTargetHandle = NULL;
            if( ( targetSel & 0x1u ) != 0u )
            {
                xTargetHandle = xRestrictedTaskHandle;
            }

            /* Build a new set of MPU regions from fuzz input. */
            MemoryRegion_t xRegions[ portNUM_CONFIGURABLE_REGIONS ];

            for( size_t i = 0; i < portNUM_CONFIGURABLE_REGIONS; i++ )
            {
                uint8_t baseSel;
                uint8_t lenByte;
                uint8_t paramBits;

                if( FR_next_u8( &fr, &baseSel ) != 0 ||
                    FR_next_u8( &fr, &lenByte )  != 0 ||
                    FR_next_u8( &fr, &paramBits )!= 0 )
                {
                    /* Not enough data to fill all regions; stop fuzzing this input. */
                    break;
                }

                void * pvBase = NULL;
                uint32_t ulLen = 0U;
                uint32_t ulParams = 0U;

                /* Choose one of several statically defined bases or NULL. */
                switch( baseSel % 4U )
                {
                    case 0:
                        pvBase = ucRegionBuf1;
                        ulLen  = sizeof( ucRegionBuf1 );
                        break;
                    case 1:
                        pvBase = ucRegionBuf2;
                        ulLen  = sizeof( ucRegionBuf2 );
                        break;
                    case 2:
                        /* Use middle of buffer 2 to vary alignment/size within constraints. */
                        pvBase = &ucRegionBuf2[ lenByte % ( sizeof( ucRegionBuf2 ) / 2U ) ];
                        ulLen  = ( (uint32_t)lenByte + 1U ) * 4U;
                        break;
                    default:
                        pvBase = NULL;
                        ulLen  = 0U;
                        break;
                }

                /* Map fuzz bits into a combination of MPU attribute flags. */
                if( ( paramBits & 0x01u ) != 0u )
                {
                    ulParams |= portMPU_REGION_READ_WRITE;
                }
                if( ( paramBits & 0x02u ) != 0u )
                {
                    ulParams |= portMPU_REGION_READ_ONLY;
                }
                if( ( paramBits & 0x04u ) != 0u )
                {
                    ulParams |= portMPU_REGION_PRIVILEGED_READ_ONLY;
                }
                if( ( paramBits & 0x08u ) != 0u )
                {
                    ulParams |= portMPU_REGION_PRIVILEGED_READ_WRITE;
                }
                if( ( paramBits & 0x10u ) != 0u )
                {
                    ulParams |= portMPU_REGION_CACHEABLE_BUFFERABLE;
                }
                if( ( paramBits & 0x20u ) != 0u )
                {
                    ulParams |= portMPU_REGION_EXECUTE_NEVER;
                }

                xRegions[ i ].pvBaseAddress   = pvBase;
                xRegions[ i ].ulLengthInBytes = ulLen;
                xRegions[ i ].ulParameters    = ulParams;
            }

            /* Call the API under test. This will assert internally if the handle is invalid. */
            vTaskAllocateMPURegions( xTargetHandle, xRegions );

            /* Yield to allow any MPU changes to take effect in the scheduler. */
            taskYIELD();
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

