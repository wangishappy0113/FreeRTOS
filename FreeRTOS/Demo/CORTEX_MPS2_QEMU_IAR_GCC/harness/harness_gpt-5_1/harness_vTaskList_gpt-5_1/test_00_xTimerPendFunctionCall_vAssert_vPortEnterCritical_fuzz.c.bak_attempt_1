/* Static storage for timer queue and daemon task. */

#ifndef CONFIG_TIMER_QUEUE_LENGTH
#define CONFIG_TIMER_QUEUE_LENGTH 5
#endif

#ifndef CONFIG_TIMER_TASK_STACK_DEPTH
#define CONFIG_TIMER_TASK_STACK_DEPTH 256
#endif

#ifndef CONFIG_TIMER_TASK_PRIORITY
#define CONFIG_TIMER_TASK_PRIORITY ( tskIDLE_PRIORITY + 1 )
#endif

/* Daemon task message type must match the FreeRTOS timers.c expectations. */
typedef struct DaemonTaskMessage
{
    BaseType_t xMessageID;
    union
    {
        struct
        {
            PendedFunction_t pxCallbackFunction;
            void * pvParameter1;
            uint32_t ulParameter2;
        } xCallbackParameters;
    } u;
} DaemonTaskMessage_t;

/* Extern declaration for the timer queue used by xTimerPendFunctionCall. */
extern QueueHandle_t xTimerQueue;

/* Static queue storage for the timer daemon queue. */
static StaticQueue_t xTimerQueueStatic;
static uint8_t ucTimerQueueStorageArea[ CONFIG_TIMER_QUEUE_LENGTH * sizeof( DaemonTaskMessage_t ) ];

/* Static storage for the daemon task. */
static StaticTask_t xTimerDaemonTaskTCB;
static StackType_t xTimerDaemonTaskStack[ CONFIG_TIMER_TASK_STACK_DEPTH ];

/* Simple structure used as pvParameter1 for callbacks. */
typedef struct FuzzParamStruct
{
    uint32_t a;
    uint32_t b;
} FuzzParamStruct_t;

/* Global instance used as a stable pointer for pvParameter1. */
static FuzzParamStruct_t xGlobalFuzzParam;

/* State to track how many times the callback ran and last parameters. */
static volatile uint32_t ulCallbackInvokeCount = 0;
static volatile uint32_t ulLastCallbackParam2 = 0;
static volatile uint32_t ulLastCallbackStructA = 0;
static volatile uint32_t ulLastCallbackStructB = 0;

/* Flag to ensure one-time initialization of timer queue and daemon task. */
static BaseType_t xTimerInfraInitialized = pdFALSE;

/* Forward declaration of daemon task. */
static void vTimerDaemonTask( void * pvParameters );

/* Example pended function that will be executed in the context of the daemon task. */
static void vFuzzPendedFunction( void * pvParameter1, uint32_t ulParameter2 )
{
    FuzzParamStruct_t * px = ( FuzzParamStruct_t * ) pvParameter1;

    /* Enter and exit critical section to exercise vPortEnterCritical path. */
    taskENTER_CRITICAL();

    ulCallbackInvokeCount++;
    ulLastCallbackParam2 = ulParameter2;

    if( px != NULL )
    {
        ulLastCallbackStructA = px->a;
        ulLastCallbackStructB = px->b;
    }

    taskEXIT_CRITICAL();
}

/* Minimal daemon task that receives messages from xTimerQueue and executes callbacks. */
static void vTimerDaemonTask( void * pvParameters )
{
    ( void ) pvParameters;

    for( ;; )
    {
        DaemonTaskMessage_t xMsg;

        /* Block for a short time to avoid tight spinning; this is acceptable
         * because the outer fuzz harness already bounds total runtime. */
        if( xQueueReceive( xTimerQueue, &xMsg, pdMS_TO_TICKS( 50 ) ) == pdPASS )
        {
            if( xMsg.xMessageID == tmrCOMMAND_EXECUTE_CALLBACK )
            {
                if( xMsg.u.xCallbackParameters.pxCallbackFunction != NULL )
                {
                    xMsg.u.xCallbackParameters.pxCallbackFunction(
                        xMsg.u.xCallbackParameters.pvParameter1,
                        xMsg.u.xCallbackParameters.ulParameter2 );
                }
            }
        }
    }
}

/* One-time initialization of timer queue and daemon task. Must be called
 * from a running task context before using xTimerPendFunctionCall. */
static void vInitTimerInfrastructureOnce( void )
{
    if( xTimerInfraInitialized == pdTRUE )
    {
        return;
    }

    /* Create the timer queue statically. */
    xTimerQueue = xQueueCreateStatic( CONFIG_TIMER_QUEUE_LENGTH,
                                      ( UBaseType_t ) sizeof( DaemonTaskMessage_t ),
                                      ucTimerQueueStorageArea,
                                      &xTimerQueueStatic );

    configASSERT( xTimerQueue != NULL );

    /* Create the daemon task statically. Run it at a priority that should
     * be at least as high as the fuzz test task. */
    TaskHandle_t xDaemonHandle = xTaskCreateStatic( vTimerDaemonTask,
                                                    "TmrDaemon",
                                                    CONFIG_TIMER_TASK_STACK_DEPTH,
                                                    NULL,
                                                    ( UBaseType_t ) ( CONFIG_TIMER_TASK_PRIORITY | portPRIVILEGE_BIT ),
                                                    xTimerDaemonTaskStack,
                                                    &xTimerDaemonTaskTCB );

    configASSERT( xDaemonHandle != NULL );

    xTimerInfraInitialized = pdTRUE;
}


