static StaticEventGroup_t g_event_group_buf;
static EventGroupHandle_t g_event_group = NULL;

/* Simple structure to pass as pvParameter1 to pended callbacks. */
typedef struct
{
    uint32_t tag;
    uint32_t value;
} FuzzParam_t;

static FuzzParam_t g_fuzz_param_storage[4];

/* A few different callbacks to exercise xTimerPendFunctionCallFromISR via xEventGroupSetBitsFromISR. */
static void vFuzzCallbackA( void * pvParameter1, uint32_t ulParameter2 )
{
    FuzzParam_t * p = ( FuzzParam_t * ) pvParameter1;
    if( p != NULL )
    {
        /* Mutate the structure in a deterministic but harmless way. */
        p->value ^= ulParameter2;
        p->tag += 1U;
    }
}

static void vFuzzCallbackB( void * pvParameter1, uint32_t ulParameter2 )
{
    ( void ) ulParameter2;
    FuzzParam_t * p = ( FuzzParam_t * ) pvParameter1;
    if( p != NULL )
    {
        /* Just overwrite with a constant pattern. */
        p->tag = 0xA5A5A5A5UL;
        p->value = 0x5A5A5A5AUL;
    }
}

static void vFuzzCallbackC( void * pvParameter1, uint32_t ulParameter2 )
{
    /* Intentionally ignore pvParameter1 sometimes to vary behavior. */
    if( ( ulParameter2 & 0x1UL ) != 0UL )
    {
        FuzzParam_t * p = ( FuzzParam_t * ) pvParameter1;
        if( p != NULL )
        {
            p->tag = ulParameter2;
        }
    }
}

static PendedFunction_t prvSelectCallbackFromByte( uint8_t selector )
{
    switch( selector % 3U )
    {
        case 0U:
            return vFuzzCallbackA;
        case 1U:
            return vFuzzCallbackB;
        default:
            return vFuzzCallbackC;
    }
}

static FuzzParam_t * prvSelectParamSlotFromByte( uint8_t selector )
{
    return &g_fuzz_param_storage[ selector % 4U ];
}

static void prvInitOnceEventGroup( void )
{
    if( g_event_group == NULL )
    {
        g_event_group = xEventGroupCreateStatic( &g_event_group_buf );
        configASSERT( g_event_group != NULL );
    }
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: xEventGroupSetBitsFromISR_and_xTimerPendFunctionCallFromISR_fuzz
    // API类别: timers
    // 描述: Fuzz xEventGroupSetBitsFromISR and its underlying xTimerPendFunctionCallFromISR by varying event bits, pended callback, and parameters while exercising the timer daemon queue from an ISR context.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            /* Ensure the shared event group exists once. */
            prvInitOnceEventGroup();

            /* We assume an FR_Reader named 'fr' is already initialized by the harness. */
            /* Need at least 16 bytes overall; if not available, stop fuzzing. */
            if( FR_remaining( &fr ) < 16U )
            {
                break; /* Break out of the harness loop. */
            }

            /* Derive parameters from fuzz input. */
            uint8_t cb_sel_raw;
            uint8_t param_slot_raw;
            uint32_t ulParam2;
            uint32_t bits_raw;
            uint8_t extra1;
            uint8_t extra2;

            if( !FR_next_u8( &fr, &cb_sel_raw ) ) break;
            if( !FR_next_u8( &fr, &param_slot_raw ) ) break;
            if( !FR_next_u32( &fr, &ulParam2 ) ) break;
            if( !FR_next_u32( &fr, &bits_raw ) ) break;
            if( !FR_next_u8( &fr, &extra1 ) ) break;
            if( !FR_next_u8( &fr, &extra2 ) ) break;

            /* Map raw bits into a smaller mask to avoid degenerate all-zeros/all-ones too often. */
            EventBits_t uxBitsToSet = ( EventBits_t ) ( bits_raw | ( ( EventBits_t ) extra1 << 8 ) );

            /* Choose which callback and parameter slot to use. */
            PendedFunction_t cb = prvSelectCallbackFromByte( cb_sel_raw );
            FuzzParam_t * pSlot = prvSelectParamSlotFromByte( param_slot_raw );

            /* Initialize or mutate the parameter slot deterministically. */
            pSlot->tag ^= ( uint32_t ) extra2;
            pSlot->value += ulParam2;

            /* Sometimes call xTimerPendFunctionCallFromISR directly, sometimes via xEventGroupSetBitsFromISR. */
            BaseType_t xHigherPriorityTaskWoken = pdFALSE;
            BaseType_t xRes1 = pdFAIL;
            BaseType_t xRes2 = pdFAIL;

            if( ( extra1 & 0x1U ) != 0U )
            {
                /* Directly exercise xTimerPendFunctionCallFromISR with chosen callback. */
                xRes1 = xTimerPendFunctionCallFromISR( cb,
                                                      ( ( extra2 & 0x1U ) != 0U ) ? ( void * ) pSlot : NULL,
                                                      ulParam2,
                                                      &xHigherPriorityTaskWoken );
            }

            /* Always exercise xEventGroupSetBitsFromISR, which internally calls xTimerPendFunctionCallFromISR
             * with vEventGroupSetBitsCallback. */
            BaseType_t xHigherPriorityTaskWoken2 = pdFALSE;
            xRes2 = xEventGroupSetBitsFromISR( g_event_group,
                                               uxBitsToSet,
                                               &xHigherPriorityTaskWoken2 );

            /* Basic sanity checks: results must be either pdPASS or not; just ensure API returned. */
            ( void ) xRes1;
            ( void ) xRes2;
            ( void ) xHigherPriorityTaskWoken;
            ( void ) xHigherPriorityTaskWoken2;
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

