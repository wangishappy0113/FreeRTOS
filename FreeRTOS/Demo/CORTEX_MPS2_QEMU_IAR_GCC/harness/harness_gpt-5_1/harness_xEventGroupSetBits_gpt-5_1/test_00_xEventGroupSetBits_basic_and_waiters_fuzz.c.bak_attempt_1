// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
#include <stdint.h>
#include <stddef.h>
#include <string.h>
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
static StaticEventGroup_t g_event_group_buf;
static EventGroupHandle_t g_event_group = NULL;

#define MAX_HELPER_TASKS 3
#define HELPER_TASK_STACK_DEPTH 128

static StaticTask_t g_helper_tcb[MAX_HELPER_TASKS];
static StackType_t g_helper_stacks[MAX_HELPER_TASKS][HELPER_TASK_STACK_DEPTH];
static TaskHandle_t g_helper_handles[MAX_HELPER_TASKS];

/* Per-helper-task configuration derived from fuzz input. */
typedef struct HelperCfg
{
    EventBits_t bits_to_wait_for;
    BaseType_t wait_for_all;
    BaseType_t clear_on_exit;
    TickType_t block_ticks;
    UBaseType_t priority;
} HelperCfg;

static HelperCfg g_helper_cfg[MAX_HELPER_TASKS];

static void helper_task(void *pvParameters)
{
    HelperCfg *cfg = (HelperCfg *) pvParameters;

    if (g_event_group == NULL)
    {
        vTaskDelete(NULL);
        return;
    }

    EventBits_t uxBitsToWaitFor = cfg->bits_to_wait_for & 0x00FFFFFFu; /* keep in user range */
    if (uxBitsToWaitFor == 0)
    {
        /* Nothing meaningful to wait for; just delete. */
        vTaskDelete(NULL);
        return;
    }

    BaseType_t wait_all = (cfg->wait_for_all != 0) ? pdTRUE : pdFALSE;
    BaseType_t clear_on_exit = (cfg->clear_on_exit != 0) ? pdTRUE : pdFALSE;

    (void) xEventGroupWaitBits(
        g_event_group,
        uxBitsToWaitFor,
        clear_on_exit,
        wait_all,
        cfg->block_ticks);

    vTaskDelete(NULL);
}

static void ensure_event_group_created(void)
{
    if (g_event_group == NULL)
    {
        g_event_group = xEventGroupCreateStatic(&g_event_group_buf);
        configASSERT(g_event_group != NULL);
    }
}

static void create_or_update_helper_tasks(FR_Reader *fr)
{
    /* Decide how many helper tasks to (re)create this iteration. */
    if (FR_remaining(fr) < 1)
    {
        return;
    }

    uint8_t count_raw = FR_next_u8(fr);
    UBaseType_t num_tasks = (UBaseType_t)(count_raw % (MAX_HELPER_TASKS + 1));

    /* Delete any existing helper tasks first to avoid handle reuse confusion. */
    for (UBaseType_t i = 0; i < MAX_HELPER_TASKS; i++)
    {
        if (g_helper_handles[i] != NULL)
        {
            vTaskDelete(g_helper_handles[i]);
            g_helper_handles[i] = NULL;
        }
    }

    for (UBaseType_t i = 0; i < num_tasks; i++)
    {
        if (FR_remaining(fr) < 8)
        {
            /* Not enough data to configure more tasks. */
            break;
        }

        uint32_t bits_raw = FR_next_u32(fr);
        uint8_t flags = FR_next_u8(fr);
        uint16_t ticks_raw = FR_next_u16(fr);
        uint8_t prio_raw = FR_next_u8(fr);

        g_helper_cfg[i].bits_to_wait_for = (EventBits_t)(bits_raw & 0x00FFFFFFu);
        g_helper_cfg[i].wait_for_all = (flags & 0x1u) ? pdTRUE : pdFALSE;
        g_helper_cfg[i].clear_on_exit = (flags & 0x2u) ? pdTRUE : pdFALSE;
        g_helper_cfg[i].block_ticks = (TickType_t)(ticks_raw % 50u); /* keep bounded */

        UBaseType_t base_prio = uxTaskPriorityGet(NULL);
        UBaseType_t max_prio = configMAX_PRIORITIES - 1u;
        UBaseType_t span = (max_prio > base_prio) ? (max_prio - base_prio) : 0u;
        UBaseType_t offset = (span > 0u) ? (prio_raw % (span + 1u)) : 0u;
        g_helper_cfg[i].priority = base_prio + offset;

        TaskHandle_t h = xTaskCreateStatic(
            helper_task,
            "hEvt",
            HELPER_TASK_STACK_DEPTH,
            &g_helper_cfg[i],
            g_helper_cfg[i].priority,
            g_helper_stacks[i],
            &g_helper_tcb[i]);

        configASSERT(h != NULL);
        g_helper_handles[i] = h;
    }
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: xEventGroupSetBits_basic_and_waiters_fuzz
    // API类别: event_groups
    // 描述: Fuzzes xEventGroupSetBits with varying bit patterns while multiple tasks wait on different combinations of bits, including wait-for-all and clear-on-exit behaviors. Ensures event group integrity, correct unblocking, and interaction with task priorities.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            static BaseType_t initialized = pdFALSE;
            static FR_Reader fr;

            if (initialized == pdFALSE)
            {
                FR_init(&fr, FUZZ_INPUT, FUZZ_INPUT_LEN);
                ensure_event_group_created();
                initialized = pdTRUE;
            }

            /* Ensure we have enough bytes to drive at least one meaningful action. */
            if (FR_remaining(&fr) < 16)
            {
                break; /* exit fuzz loop in harness */
            }

            /* Optionally (re)create helper tasks that wait on various bit patterns. */
            create_or_update_helper_tasks(&fr);

            if (FR_remaining(&fr) < 4)
            {
                break;
            }

            /* Derive bits to set from fuzz input, masking out control bits to satisfy configASSERT. */
            uint32_t raw_bits = FR_next_u32(&fr);
            EventBits_t uxBitsToSet = (EventBits_t)(raw_bits & ~eventEVENT_BITS_CONTROL_BYTES);

            /* Call the function under test. */
            EventBits_t before = xEventGroupGetBits(g_event_group);
            (void) before; /* value kept for potential debug; avoid unused warning */

            EventBits_t ret = xEventGroupSetBits(g_event_group, uxBitsToSet);

            /* Basic sanity: returned bits must not have control bits set. */
            configASSERT((ret & eventEVENT_BITS_CONTROL_BYTES) == 0);

            /* Yield to allow helper tasks to run and potentially clear bits. */
            taskYIELD();

            /* Read back bits to ensure event group handle is still valid and bits are in user range. */
            EventBits_t after = xEventGroupGetBits(g_event_group);
            configASSERT((after & eventEVENT_BITS_CONTROL_BYTES) == 0);

            (void) ret;
            (void) after;
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

