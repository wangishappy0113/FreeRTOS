// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
#include <stdint.h>
#include <stddef.h>
#include <string.h>
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
static StaticEventGroup_t g_event_group_buf;
static EventGroupHandle_t g_event_group = NULL;

#define MAX_HELPER_TASKS 2
#define HELPER_TASK_STACK_WORDS 128

static StaticTask_t g_helper_tcb[MAX_HELPER_TASKS];
static StackType_t g_helper_stacks[MAX_HELPER_TASKS][HELPER_TASK_STACK_WORDS];
static TaskHandle_t g_helper_handles[MAX_HELPER_TASKS] = { NULL };

/* Simple helper task that optionally participates in the rendezvous by
 * setting bits on the shared event group, then exits. Parameters are
 * passed via its notification value to avoid dynamic allocation. */
static void helper_task_fn( void *pvParameters )
{
    ( void ) pvParameters;

    /* Decode parameters from notification value: lower 16 bits = bitsToSet,
     * upper 16 bits = delay ticks before setting. */
    uint32_t ulNotifyVal = 0;
    ( void ) xTaskNotifyWait( 0, 0xFFFFFFFFu, &ulNotifyVal, 0 );

    EventBits_t bits_to_set = ( EventBits_t ) ( ulNotifyVal & 0xFFFFu );
    TickType_t delay_ticks = ( TickType_t ) ( ( ulNotifyVal >> 16 ) & 0xFFFFu );

    if( delay_ticks > 0 )
    {
        vTaskDelay( delay_ticks );
    }

    if( g_event_group != NULL && bits_to_set != 0 )
    {
        ( void ) xEventGroupSetBits( g_event_group, bits_to_set );
    }

    vTaskDelete( NULL );
}

static void ensure_event_group_created( void )
{
    if( g_event_group == NULL )
    {
        g_event_group = xEventGroupCreateStatic( &g_event_group_buf );
        configASSERT( g_event_group != NULL );
    }
}

static UBaseType_t create_helper_tasks_from_fuzz( FR_Reader *fr, EventBits_t rendezvous_mask )
{
    /* Decide how many helper tasks to create: 0..MAX_HELPER_TASKS. */
    uint8_t count_raw;
    if( !FR_next_u8( fr, &count_raw ) )
    {
        return 0;
    }
    UBaseType_t to_create = ( UBaseType_t ) ( count_raw % ( MAX_HELPER_TASKS + 1 ) );

    UBaseType_t created = 0;
    for( UBaseType_t i = 0; i < to_create; i++ )
    {
        /* Derive bits to set and delay from fuzz. */
        uint16_t bits_raw, delay_raw;
        if( !FR_next_u16( fr, &bits_raw ) )
        {
            break;
        }
        if( !FR_next_u16( fr, &delay_raw ) )
        {
            break;
        }

        EventBits_t bits_to_set = ( EventBits_t ) ( bits_raw ) & rendezvous_mask;
        TickType_t delay_ticks = ( TickType_t ) ( delay_raw % 50u );

        /* Create task only if not already alive in this slot. */
        if( g_helper_handles[i] == NULL )
        {
            TaskHandle_t h = xTaskCreateStatic( helper_task_fn,
                                                "hSync",
                                                HELPER_TASK_STACK_WORDS,
                                                NULL,
                                                ( tskIDLE_PRIORITY + 1 ) | portPRIVILEGE_BIT,
                                                g_helper_stacks[i],
                                                &g_helper_tcb[i] );
            if( h != NULL )
            {
                g_helper_handles[i] = h;

                uint32_t notify_val = ( ( ( uint32_t ) delay_ticks ) << 16 ) | ( ( uint32_t ) bits_to_set );
                ( void ) xTaskNotify( h, notify_val, eSetValueWithOverwrite );

                created++;
            }
        }
    }

    return created;
}

static void cleanup_finished_helpers( void )
{
    /* Any helper that has deleted itself will leave its handle invalid, but
     * we cannot query that directly. Instead, we simply clear slots whose
     * tasks are in the deleted state when inspected. */
    for( UBaseType_t i = 0; i < MAX_HELPER_TASKS; i++ )
    {
        TaskHandle_t h = g_helper_handles[i];
        if( h != NULL )
        {
            eTaskState st = eTaskGetState( h );
            if( st == eDeleted )
            {
                g_helper_handles[i] = NULL;
            }
        }
    }
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: xEventGroupSync_rendezvous_fuzz
    // API类别: event_groups
    // 描述: Fuzz xEventGroupSync rendezvous behavior with multiple tasks using static event group and varying bits/timeouts derived from FUZZ_INPUT.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            ensure_event_group_created();

            /* Derive rendezvous parameters from fuzz input. Ensure we have enough
             * bytes; if not, exit this iteration. We need at least:
             * 1 byte for helper count, 2 for bitsToSet, 2 for bitsToWaitFor,
             * 4 for ticksToWait, plus some for helpers. Require 16 total. */
            if( FR_remaining( &fr ) < 16 )
            {
                break;
            }

            uint16_t bits_set_raw, bits_wait_raw;
            uint32_t ticks_raw;

            if( !FR_next_u16( &fr, &bits_set_raw ) )
            {
                break;
            }
            if( !FR_next_u16( &fr, &bits_wait_raw ) )
            {
                break;
            }
            if( !FR_next_u32( &fr, &ticks_raw ) )
            {
                break;
            }

            /* Mask off control bits as required by configASSERT in xEventGroupSync. */
            EventBits_t wait_mask = ( EventBits_t ) bits_wait_raw;
            wait_mask &= ~eventEVENT_BITS_CONTROL_BYTES;

            /* Ensure uxBitsToWaitFor is non-zero to satisfy configASSERT. If fuzz
             * produced zero after masking, force a single bit. */
            if( wait_mask == 0 )
            {
                wait_mask = 0x1u;
            }

            EventBits_t set_mask = ( EventBits_t ) bits_set_raw;
            set_mask &= ~eventEVENT_BITS_CONTROL_BYTES;

            /* Limit timeout to a small range to keep tests bounded. */
            TickType_t ticks_to_wait = ( TickType_t ) ( ticks_raw % 100u );

            /* Optionally pre-set some bits in the event group to explore paths where
             * the rendezvous is already satisfied or partially satisfied. */
            uint8_t preset_raw;
            if( !FR_next_u8( &fr, &preset_raw ) )
            {
                break;
            }
            EventBits_t preset_bits = ( EventBits_t ) ( preset_raw );
            preset_bits &= wait_mask;
            if( preset_bits != 0 )
            {
                ( void ) xEventGroupSetBits( g_event_group, preset_bits );
            }

            /* Create a few helper tasks that will set bits and potentially unblock
             * this task's rendezvous. */
            ( void ) create_helper_tasks_from_fuzz( &fr, wait_mask );

            /* Call the function under test from the fuzz task context. */
            EventBits_t ret = xEventGroupSync( g_event_group, set_mask, wait_mask, ticks_to_wait );

            /* Basic sanity checks on return value: control bits must be clear. */
            configASSERT( ( ret & eventEVENT_BITS_CONTROL_BYTES ) == 0 );

            /* If timeout was zero, xEventGroupSync should not have blocked; we can
             * at least assert that the returned bits include any bits we just set
             * in this call (unless they were cleared by rendezvous). This is a
             * weak check, so we only ensure no crash and consistent mask usage. */
            ( void ) ret;

            /* Clean up any helper tasks that have finished. */
            cleanup_finished_helpers();
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

