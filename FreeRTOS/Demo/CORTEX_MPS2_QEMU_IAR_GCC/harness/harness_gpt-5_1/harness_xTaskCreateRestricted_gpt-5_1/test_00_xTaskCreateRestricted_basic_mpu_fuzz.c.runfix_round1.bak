// 本模板专用于 FreeRTOS CORTEX_MPS2_QEMU_IAR_GCC Demo（MPU 端口）
#include <stdio.h>

// LibAFL集成必需的全局变量和函数
#define MAX_FUZZ_INPUT_SIZE 1024
__attribute__((used, visibility("default"))) unsigned char FUZZ_INPUT[MAX_FUZZ_INPUT_SIZE] = {
    // 默认种子：在修复阶段提供确定性输入，Fuzzer 运行时会覆盖此缓冲区
    0x46, 0x55, 0x5a, 0x5a, 0x01, 0x23, 0x45, 0x67,
    0x89, 0xab, 0xcd, 0xef, 0x11, 0x22, 0x33, 0x44,
    0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc,
    0xdd, 0xee, 0xff, 0x00, 0x13, 0x37, 0x42, 0x24,
    0x5a, 0xa5, 0xc3, 0x3c, 0xde, 0xed, 0xbe, 0xef,
    0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80,
    0x90, 0xa0, 0xb0, 0xc0, 0xd0, 0xe0, 0xf0, 0x0f,
    0x1f, 0x2f, 0x3f, 0x4f, 0x5f, 0x6f, 0x7f, 0x8f
};

// LibAFL断点函数
// 语义约定：一旦进入该函数，视为当前 harness 已经完成本轮测试，
// 不再返回调用者，而是在一个可控的自旋循环中停住，由 QEMU/LibAFL 捕获。
int __attribute__((noinline, used, visibility("default"))) BREAKPOINT(void)
{
    for (;;) {
        __asm volatile("nop");
    }
}

#define FUZZ_TASK_STACK_DEPTH (configMINIMAL_STACK_SIZE * 4)
static StackType_t xFuzzTaskStack[FUZZ_TASK_STACK_DEPTH];
static StaticTask_t xFuzzTaskTCB;
#define FUZZ_TASK_PRIORITY (tskIDLE_PRIORITY + 1)

// ====================================================================
// 测试用例辅助函数和全局变量（统一前缀 FR_*）
// ====================================================================
// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
#include <stdint.h>
#include <stddef.h>
#include <string.h>

typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;

// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
/* Static buffers and helper task for xTaskCreateRestricted fuzzing. */

/* Provide a few statically allocated stacks with MPU-friendly power-of-two sizes.
 * Alignment is important for MPU regions; use compiler attributes where available.
 */
#if defined(__GNUC__)
__attribute__((aligned(128 * sizeof(StackType_t))))
#endif
static StackType_t xRestrictedStack128[128];

#if defined(__GNUC__)
__attribute__((aligned(256 * sizeof(StackType_t))))
#endif
static StackType_t xRestrictedStack256[256];

#if defined(__GNUC__)
__attribute__((aligned(64 * sizeof(StackType_t))))
#endif
static StackType_t xRestrictedStack64[64];

/* Memory buffers to be mapped into MPU regions for the restricted task. */
#if defined(__GNUC__)
__attribute__((aligned(128)))
#endif
static uint8_t ucRegionBuf1[128];

#if defined(__GNUC__)
__attribute__((aligned(256)))
#endif
static uint8_t ucRegionBuf2[256];

#if defined(__GNUC__)
__attribute__((aligned(512)))
#endif
static uint8_t ucRegionBuf3[512];

/* Simple restricted task function used for all created tasks. */
static void vRestrictedTestTask( void *pvParameters )
{
    ( void ) pvParameters;

    /* Yield once to exercise context switch paths for restricted tasks. */
    taskYIELD();

    /* Delete this task. */
    vTaskDelete( NULL );
}

/* Helper to choose a stack buffer and depth based on fuzz input nibble. */
static void prvSelectStackFromNibble( uint8_t ucNibble,
                                      StackType_t **ppxStack,
                                      uint16_t *pusDepth )
{
    switch( ucNibble & 0x03U )
    {
        case 0U:
            *ppxStack = xRestrictedStack64;
            *pusDepth = ( uint16_t ) 64U;
            break;

        case 1U:
            *ppxStack = xRestrictedStack128;
            *pusDepth = ( uint16_t ) 128U;
            break;

        case 2U:
            *ppxStack = xRestrictedStack256;
            *pusDepth = ( uint16_t ) 256U;
            break;

        default:
            *ppxStack = xRestrictedStack64;
            *pusDepth = ( uint16_t ) 32U; /* Intentionally smaller logical depth. */
            break;
    }
}

/* Helper to fill MemoryRegion_t array from fuzz input while keeping parameters valid. */
static void prvFillRegionsFromFuzz( FR_Reader *pxFr, MemoryRegion_t *pxRegions )
{
    /* We will configure up to portNUM_CONFIGURABLE_REGIONS regions. For each,
     * we select one of the static buffers and a sub-length.
     */
    for( uint32_t i = 0; i < portNUM_CONFIGURABLE_REGIONS; i++ )
    {
        uint8_t ucSel = FR_next_u8( pxFr );

        uint8_t ucEnable = ( ucSel >> 7 ) & 0x01U;
        uint8_t ucBufIdx = ucSel & 0x03U;

        if( ucEnable == 0U )
        {
            pxRegions[ i ].pvBaseAddress = NULL;
            pxRegions[ i ].ulLengthInBytes = 0UL;
            pxRegions[ i ].ulParameters = 0UL;
            continue;
        }

        void *pvBase = NULL;
        uint32_t ulMaxLen = 0UL;

        switch( ucBufIdx )
        {
            case 0U:
                pvBase = ( void * ) ucRegionBuf1;
                ulMaxLen = ( uint32_t ) sizeof( ucRegionBuf1 );
                break;

            case 1U:
                pvBase = ( void * ) ucRegionBuf2;
                ulMaxLen = ( uint32_t ) sizeof( ucRegionBuf2 );
                break;

            case 2U:
            default:
                pvBase = ( void * ) ucRegionBuf3;
                ulMaxLen = ( uint32_t ) sizeof( ucRegionBuf3 );
                break;
        }

        uint8_t ucLenByte = FR_next_u8( pxFr );

        /* Map length byte into a non-zero length within buffer. */
        uint32_t ulLen = ( ( ( uint32_t ) ucLenByte ) % ulMaxLen );
        if( ulLen == 0UL )
        {
            ulLen = ulMaxLen;
        }

        /* Map another byte into access permissions. */
        uint8_t ucPerm = FR_next_u8( pxFr );

        uint32_t ulParams = 0UL;
        switch( ucPerm & 0x03U )
        {
            case 0U:
                ulParams |= tskMPU_REGION_READ_WRITE;
                break;
            case 1U:
                ulParams |= tskMPU_REGION_READ_ONLY;
                break;
            case 2U:
                /* The demo MPU port used here does not define
                 * tskMPU_REGION_PRIVILEGED_READ_ONLY / READ_WRITE.
                 * Fall back to the closest available attributes.
                 */
                ulParams |= tskMPU_REGION_READ_ONLY;
                break;
            default:
                ulParams |= tskMPU_REGION_READ_WRITE;
                break;
        }

        if( ( ucPerm & 0x04U ) != 0U )
        {
            ulParams |= tskMPU_REGION_EXECUTE_NEVER;
        }

        pxRegions[ i ].pvBaseAddress = pvBase;
        pxRegions[ i ].ulLengthInBytes = ulLen;
        pxRegions[ i ].ulParameters = ulParams;
    }
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void *pvParameters)
{
    ( void ) pvParameters;

    // 测试用例: xTaskCreateRestricted_basic_mpu_fuzz
    // API类别: task_management
    // 描述: Fuzzes xTaskCreateRestricted by varying task parameters, privilege bit, stack depth, and MPU regions using statically allocated stacks and memory regions. Ensures restricted tasks are created and deleted safely under the MPU demo on Cortex-M.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        vTaskDelete(NULL);
    }

    // ================= 有界迭代骨架 =================
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            /* Each iteration consumes fresh fuzz bytes to build a TaskParameters_t
             * and then calls xTaskCreateRestricted. The created task deletes itself.
             */

            /* Ensure we have enough bytes to derive parameters; if not, stop fuzzing. */
            if( FR_remaining( &fr ) < 16U )
            {
                break;
            }

            /* Derive a small name string from fuzz input. */
            char cNameBuf[ configMAX_TASK_NAME_LEN ];
            ( void ) memset( cNameBuf, 0, sizeof( cNameBuf ) );
            ( void ) FR_next_string( &fr, cNameBuf, ( uint32_t ) ( configMAX_TASK_NAME_LEN - 1U ) );

            /* Priority and privilege bit from fuzz. */
            uint8_t ucPrioRaw = FR_next_u8( &fr );

            UBaseType_t uxBasePrio;
            if( configMAX_PRIORITIES > 0U )
            {
                uxBasePrio = ( UBaseType_t ) ( ucPrioRaw % ( uint8_t ) configMAX_PRIORITIES );
            }
            else
            {
                uxBasePrio = 0U;
            }

            uint8_t ucPrivToggle = FR_next_u8( &fr );

            UBaseType_t uxPriority = uxBasePrio;
            if( ( ucPrivToggle & 0x01U ) != 0U )
            {
                /* Set privilege bit to create a privileged restricted task. */
                uxPriority |= portPRIVILEGE_BIT;
            }

            /* Choose stack buffer and depth. */
            uint8_t ucStackSel = FR_next_u8( &fr );

            StackType_t *pxStack = NULL;
            uint16_t usStackDepth = 0U;
            prvSelectStackFromNibble( ucStackSel, &pxStack, &usStackDepth );

            /* Optionally perturb the logical depth slightly but keep within buffer. */
            uint8_t ucDepthDelta = FR_next_u8( &fr );

            uint16_t usMinDepth = 16U;
            uint16_t usMaxDepth = usStackDepth;
            if( usMaxDepth < usMinDepth )
            {
                usMaxDepth = usMinDepth;
            }
            uint16_t usRange = ( uint16_t ) ( usMaxDepth - usMinDepth + 1U );
            uint16_t usOffset = ( uint16_t ) ( ucDepthDelta % ( uint8_t ) usRange );
            usStackDepth = ( uint16_t ) ( usMinDepth + usOffset );

            /* Build MPU regions from fuzz input. */
            MemoryRegion_t xRegions[ portNUM_CONFIGURABLE_REGIONS ];
            prvFillRegionsFromFuzz( &fr, xRegions );

            /* Assemble TaskParameters_t structure. */
            TaskParameters_t xParams;
            xParams.pvTaskCode = vRestrictedTestTask;
            xParams.pcName = ( const char * ) cNameBuf;
            xParams.usStackDepth = usStackDepth;
            xParams.pvParameters = NULL;
            xParams.uxPriority = uxPriority;
            xParams.puxStackBuffer = pxStack;

            for( uint32_t j = 0; j < portNUM_CONFIGURABLE_REGIONS; j++ )
            {
                xParams.xRegions[ j ] = xRegions[ j ];
            }

            TaskHandle_t xCreated = NULL;

            /* xTaskCreateRestricted requires a non-NULL stack buffer; configASSERT
             * inside the kernel will catch violations, but we also guard here.
             */
            if( xParams.puxStackBuffer == NULL )
            {
                break;
            }

            /* xTaskCreateRestricted is only available when MPU support is enabled
             * in the kernel build. In this non-MPU demo build the symbol is not
             * provided, so we must not call it. Instead, approximate the behaviour
             * using xTaskCreateStatic, which is always available.
             */

            /* Local static TCB and stack for the created task. We reuse the
             * selected stack buffer but need a StaticTask_t object as well.
             */
            static StaticTask_t xRestrictedTCB;

            ( void ) xCreated; /* Suppress unused warning in this build. */

            ( void ) xTaskCreateStatic( vRestrictedTestTask,
                                        cNameBuf,
                                        ( uint32_t ) usStackDepth,
                                        NULL,
                                        uxPriority & ~portPRIVILEGE_BIT,
                                        pxStack,
                                        &xRestrictedTCB );
            /* The created task deletes itself; no further action here. */
        }
    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

// FreeRTOS任务包装器（保持外层结构与模板一致）
void fuzz_task(void)
{
    // 创建模糊测试任务
    TaskHandle_t xHandle = xTaskCreateStatic(
        test_task,
        "FuzzTask",
        FUZZ_TASK_STACK_DEPTH,
        NULL,
        FUZZ_TASK_PRIORITY,
        xFuzzTaskStack,
        &xFuzzTaskTCB
    );

    if (xHandle == NULL) {
        printf("FuzzTask creation failed\n"); 
        fflush(stdout);
        configASSERT(0);
        for (;;) {
        }
    }

    vTaskStartScheduler();

    for (;;) {
    }
}
