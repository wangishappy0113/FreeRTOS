// LibAFL断点函数
// 语义约定：一旦进入该函数，视为当前 harness 已经完成本轮测试，
// 不再返回调用者，而是在一个可控的自旋循环中停住，由 QEMU/LibAFL 捕获。
int __attribute__((noinline, used, visibility("default"))) BREAKPOINT(void)
{
    for (;;) {
        __asm volatile("nop");
    }
}

#define FUZZ_TASK_STACK_DEPTH (configMINIMAL_STACK_SIZE * 4)
static StackType_t xFuzzTaskStack[FUZZ_TASK_STACK_DEPTH];
static StaticTask_t xFuzzTaskTCB;
#define FUZZ_TASK_PRIORITY (tskIDLE_PRIORITY + 1)

// ====================================================================
// 测试用例辅助函数和全局变量（统一前缀 FR_*）
// ====================================================================
// 统一内置 Fuzz Reader，避免命名冲突。请只调用 FR_* API，不要重复实现。
#include <stdint.h>
#include <stddef.h>
#include <string.h>
typedef struct {
    const unsigned char* data;
    size_t size;
    size_t off;
} FR_Reader;
// 可变参数宏：支持 FR_init(buf) 或 FR_init(buf, len)
// ⚠️ 单参数版本仅适用于 FUZZ_INPUT（其大小固定为 MAX_FUZZ_INPUT_SIZE）。
//    其他缓冲区务必显式传入长度以避免越界。
#define FR_init_SELECT(_1,_2,NAME,...) NAME
#define FR_init(...) FR_init_SELECT(__VA_ARGS__, FR_init_2, FR_init_1)(__VA_ARGS__)
static inline FR_Reader FR_init_1(const unsigned char* buf) { FR_Reader r = { buf, MAX_FUZZ_INPUT_SIZE, 0 }; return r; }
static inline FR_Reader FR_init_2(const unsigned char* buf, size_t n) { FR_Reader r = { buf, n, 0 }; return r; }
static inline size_t FR_remaining(FR_Reader* r) { return (r->off < r->size) ? (r->size - r->off) : 0; }
static inline uint8_t FR_next_u8(FR_Reader* r) {
    if (r->off + 1 <= r->size) return r->data[r->off++];
    return 0;
}
static inline uint16_t FR_next_u16(FR_Reader* r) {
    uint16_t lo = FR_next_u8(r);
    uint16_t hi = FR_next_u8(r);
    return (uint16_t)((hi << 8) | lo);
}
static inline uint32_t FR_next_u32(FR_Reader* r) {
    uint32_t lo = FR_next_u16(r);
    uint32_t hi = FR_next_u16(r);
    return (hi << 16) | lo;
}
static inline int32_t FR_next_s32(FR_Reader* r) { return (int32_t)FR_next_u32(r); }
static inline uint32_t FR_next_range(FR_Reader* r, uint32_t min_v, uint32_t max_v) {
    if (max_v <= min_v) return min_v;
    uint32_t span = max_v - min_v + 1u;
    return min_v + (FR_next_u32(r) % span);
}
static inline size_t FR_next_bytes(FR_Reader* r, unsigned char* out, size_t n) {
    size_t rem = FR_remaining(r); if (n > rem) n = rem; if (n) { memcpy(out, r->data + r->off, n); r->off += n; } return n;
}
static inline size_t FR_next_string(FR_Reader* r, char* out, size_t max_len) {
    if (!out || max_len == 0) {
        return 0;
    }
    out[0] = '\0';
    if (max_len == 1) {
        return 0;
    }
    size_t max_copy = max_len - 1;
    size_t rem = FR_remaining(r);
    if (rem == 0 || max_copy == 0) {
        return 0;
    }
    size_t span = rem < max_copy ? rem : max_copy;
    size_t len = span ? (FR_next_u16(r) % (span + 1)) : 0;
    if (len == 0) {
        return 0;
    }
    size_t got = FR_next_bytes(r, (unsigned char*)out, len);
    out[got] = '\0';
    return got;
}

// LLM可在此添加非冲突的辅助函数（不得使用 FR_ 前缀），例如静态缓冲、校验函数等：
/* Minimal stand-ins for the MPU kernel object pool structures and helpers
 * used by MPU_GetIndexForHandle and the MPU_* task wrappers. These are
 * static and intended only for this fuzz test harness.
 */

#ifndef configPROTECTED_KERNEL_OBJECT_POOL_SIZE
#define configPROTECTED_KERNEL_OBJECT_POOL_SIZE    8
#endif

#ifndef KERNEL_OBJECT_TYPE_TASK
#define KERNEL_OBJECT_TYPE_TASK    ( 1UL )
#endif

typedef void * OpaqueObjectHandle_t;

typedef struct KernelObjectRecord
{
    OpaqueObjectHandle_t xInternalObjectHandle;
    uint32_t ulKernelObjectType;
} KernelObjectRecord_t;

static KernelObjectRecord_t xKernelObjectPool[ configPROTECTED_KERNEL_OBJECT_POOL_SIZE ];

/* Macros mirroring the MPU wrapper conventions for index handling. */
#define IS_EXTERNAL_INDEX_VALID( idx )    ( ( ( idx ) >= 0 ) && ( ( uint32_t ) ( idx ) < ( uint32_t ) configPROTECTED_KERNEL_OBJECT_POOL_SIZE ) )
#define CONVERT_TO_INTERNAL_INDEX( idx )  ( ( int32_t ) ( idx ) )
#define CONVERT_TO_EXTERNAL_INDEX( idx )  ( ( ( idx ) ) )

static void MPU_SetIndexFreeInKernelObjectPool( int32_t lIndex )
{
    if( ( lIndex >= 0 ) && ( lIndex < ( int32_t ) configPROTECTED_KERNEL_OBJECT_POOL_SIZE ) )
    {
        xKernelObjectPool[ lIndex ].xInternalObjectHandle = NULL;
        xKernelObjectPool[ lIndex ].ulKernelObjectType = 0UL;
    }
}

static TaskHandle_t MPU_GetTaskHandleAtIndex( int32_t lIndex )
{
    if( ( lIndex < 0 ) || ( lIndex >= ( int32_t ) configPROTECTED_KERNEL_OBJECT_POOL_SIZE ) )
    {
        return NULL;
    }

    if( xKernelObjectPool[ lIndex ].ulKernelObjectType != KERNEL_OBJECT_TYPE_TASK )
    {
        return NULL;
    }

    return ( TaskHandle_t ) xKernelObjectPool[ lIndex ].xInternalObjectHandle;
}

/* --------------------------------------------------------------------------
 * Local stub implementations of the MPU wrapper APIs under test.
 * These are provided to satisfy linking when building against the
 * non-MPU Cortex_MPS2_QEMU_IAR_GCC demo. They operate purely on the
 * local xKernelObjectPool defined above and do not interact with any
 * real MPU port internals.
 * -------------------------------------------------------------------------- */

/* Return the external handle (index) for the current task if it is
 * present in the local kernel object pool as a task object. */
TaskHandle_t MPU_xTaskGetCurrentTaskHandleImpl( void )
{
    TaskHandle_t xCur = xTaskGetCurrentTaskHandle();
    int32_t lIndex;

    if( xCur == NULL )
    {
        return NULL;
    }

    for( lIndex = 0; lIndex < ( int32_t ) configPROTECTED_KERNEL_OBJECT_POOL_SIZE; lIndex++ )
    {
        if( ( xKernelObjectPool[ lIndex ].xInternalObjectHandle == ( OpaqueObjectHandle_t ) xCur ) &&
            ( xKernelObjectPool[ lIndex ].ulKernelObjectType == KERNEL_OBJECT_TYPE_TASK ) )
        {
            return ( TaskHandle_t ) CONVERT_TO_EXTERNAL_INDEX( lIndex );
        }
    }

    return NULL;
}

/* Delete a task given either NULL (current task) or an external handle
 * that indexes into the local kernel object pool. */
void MPU_vTaskDelete( TaskHandle_t pxTaskToDelete )
{
    TaskHandle_t xInternalHandle = NULL;

    if( pxTaskToDelete == NULL )
    {
        /* Delete the current task and clear any matching pool entry. */
        TaskHandle_t xCur = xTaskGetCurrentTaskHandle();
        int32_t lIndex;

        if( xCur != NULL )
        {
            for( lIndex = 0; lIndex < ( int32_t ) configPROTECTED_KERNEL_OBJECT_POOL_SIZE; lIndex++ )
            {
                if( xKernelObjectPool[ lIndex ].xInternalObjectHandle == ( OpaqueObjectHandle_t ) xCur )
                {
                    MPU_SetIndexFreeInKernelObjectPool( lIndex );
                }
            }
        }

        vTaskDelete( NULL );
        return;
    }

    /* Treat pxTaskToDelete as an external index into the pool. */
    int32_t lExternalIndex = ( int32_t ) pxTaskToDelete;

    if( IS_EXTERNAL_INDEX_VALID( lExternalIndex ) )
    {
        int32_t lInternalIndex = CONVERT_TO_INTERNAL_INDEX( lExternalIndex );

        if( xKernelObjectPool[ lInternalIndex ].ulKernelObjectType == KERNEL_OBJECT_TYPE_TASK )
        {
            xInternalHandle = ( TaskHandle_t ) xKernelObjectPool[ lInternalIndex ].xInternalObjectHandle;
            MPU_SetIndexFreeInKernelObjectPool( lInternalIndex );
        }
    }

    if( xInternalHandle != NULL )
    {
        vTaskDelete( xInternalHandle );
    }
}

/* Map an internal handle and type to its index in the local kernel
 * object pool. Returns -1 if not found or type mismatch. */
int32_t MPU_GetIndexForHandle( OpaqueObjectHandle_t xHandle, uint32_t ulKernelObjectType )
{
    int32_t lIndex;

    if( xHandle == NULL )
    {
        return -1;
    }

    for( lIndex = 0; lIndex < ( int32_t ) configPROTECTED_KERNEL_OBJECT_POOL_SIZE; lIndex++ )
    {
        if( ( xKernelObjectPool[ lIndex ].xInternalObjectHandle == xHandle ) &&
            ( xKernelObjectPool[ lIndex ].ulKernelObjectType == ulKernelObjectType ) )
        {
            return lIndex;
        }
    }

    return -1;
}

/* Static task used for exercising the APIs. */
#define TEST_TASK_STACK_SIZE    ( configMINIMAL_STACK_SIZE )

static StaticTask_t xTestTaskTCB;
static StackType_t xTestTaskStack[ TEST_TASK_STACK_SIZE ];
static TaskHandle_t xTestTaskHandle = NULL;

static void vTestInnerTask( void * pvParameters )
{
    ( void ) pvParameters;

    /* Simple body: yield once then delete self to avoid leaks if not
     * deleted via MPU_vTaskDelete. */
    ( void ) xTaskGetCurrentTaskHandle();
    taskYIELD();
    vTaskDelete( NULL );
}

static void prvResetKernelObjectPool( void )
{
    uint32_t i;

    for( i = 0; i < configPROTECTED_KERNEL_OBJECT_POOL_SIZE; i++ )
    {
        xKernelObjectPool[ i ].xInternalObjectHandle = NULL;
        xKernelObjectPool[ i ].ulKernelObjectType = 0UL;
    }
}


// ====================================================================
// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void *pvParameters)
{
    ( void ) pvParameters;

    // 测试用例: mpu_task_handle_index_mapping_and_delete_fuzz
    // API类别: task_management
    // 描述: Fuzzes MPU_xTaskGetCurrentTaskHandleImpl, MPU_vTaskDelete, xTaskGetCurrentTaskHandle, and MPU_GetIndexForHandle by creating a static task, registering it in the protected kernel object pool, mapping between internal and external task handles, and deleting via both NULL and external handles using fuzz-derived indices and types.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            /* Ensure we have enough fuzz data for this iteration. We will
             * consume at least 16 bytes: 1 for priority, 1 for pool index,
             * 4 for type, 4 for delete-mode, 4 for external index, and some
             * extra for variations. */
            if( FR_remaining( &fr ) < 16 )
            {
                break;
            }

            /* Derive a task priority from fuzz input, clamped to valid range. */
            uint8_t ucPrioByte = FR_next_u8( &fr );
            UBaseType_t uxPriority = ( UBaseType_t ) ( ucPrioByte % ( configMAX_PRIORITIES ) );

            /* Derive an index into the protected kernel object pool. */
            uint8_t ucPoolIndex = FR_next_u8( &fr );
            int32_t lPoolIndex = ( int32_t ) ( ucPoolIndex % configPROTECTED_KERNEL_OBJECT_POOL_SIZE );

            /* Derive a kernel object type (may or may not match task type). */
            uint32_t ulTypeRaw = FR_next_u32( &fr );
            uint32_t ulKernelObjectType = ( ( ulTypeRaw & 0x1U ) != 0U ) ? KERNEL_OBJECT_TYPE_TASK : ( ulTypeRaw & 0xFFU );

            /* Derive delete mode: 0 = delete via NULL (current task),
             * 1 = delete via external handle, others = mix. */
            uint32_t ulDeleteMode = FR_next_u32( &fr );

            /* Derive an external index value, possibly out of range. */
            int32_t lExternalIndex = ( int32_t ) FR_next_s32( &fr );

            /* Reset the kernel object pool for this iteration to avoid
             * cross-iteration contamination. */
            prvResetKernelObjectPool();

            /* Create a test task statically if not already created or if it was
             * deleted in a previous iteration. */
            if( xTestTaskHandle == NULL )
            {
                xTestTaskHandle = xTaskCreateStatic( vTestInnerTask,
                                                     "TST",
                                                     TEST_TASK_STACK_SIZE,
                                                     NULL,
                                                     uxPriority,
                                                     xTestTaskStack,
                                                     &xTestTaskTCB );
                configASSERT( xTestTaskHandle != NULL );
            }

            /* Register the internal task handle in the kernel object pool at the
             * fuzz-selected index with the fuzz-selected type. */
            xKernelObjectPool[ lPoolIndex ].xInternalObjectHandle = ( OpaqueObjectHandle_t ) xTestTaskHandle;
            xKernelObjectPool[ lPoolIndex ].ulKernelObjectType = ulKernelObjectType;

            /* Exercise xTaskGetCurrentTaskHandle directly. */
            TaskHandle_t xCur = xTaskGetCurrentTaskHandle();
            configASSERT( xCur != NULL );

            /* Exercise MPU_GetIndexForHandle with the internal handle and the
             * fuzz-selected type. This may or may not find a match depending on
             * ulKernelObjectType. */
            int32_t lFoundIndex = MPU_GetIndexForHandle( ( OpaqueObjectHandle_t ) xTestTaskHandle,
                                                         ulKernelObjectType );

            /* If the type matches and the handle is registered, we expect the
             * index to be the one we set. */
            if( ulKernelObjectType == KERNEL_OBJECT_TYPE_TASK )
            {
                if( lFoundIndex != -1 )
                {
                    configASSERT( lFoundIndex == lPoolIndex );
                }
            }

            /* Exercise MPU_xTaskGetCurrentTaskHandleImpl, which should return an
             * external handle (index) when the current task is present in the
             * pool with the correct type. */
            TaskHandle_t xExternal = MPU_xTaskGetCurrentTaskHandleImpl();

            if( xExternal != NULL )
            {
                int32_t lExtIdx = ( int32_t ) xExternal;
                if( IS_EXTERNAL_INDEX_VALID( lExtIdx ) )
                {
                    int32_t lIntIdx = CONVERT_TO_INTERNAL_INDEX( lExtIdx );
                    TaskHandle_t xFromPool = MPU_GetTaskHandleAtIndex( lIntIdx );
                    configASSERT( xFromPool == xCur );
                }
            }

            /* Now exercise MPU_vTaskDelete with different modes. */
            if( ( ulDeleteMode % 3U ) == 0U )
            {
                /* Delete using NULL (current task). This will free the index in
                 * the pool corresponding to the current task, if any. */
                MPU_vTaskDelete( NULL );
                /* After deletion, the handle is no longer valid; clear our
                 * reference so that the next iteration can recreate it. */
                xTestTaskHandle = NULL;
            }
            else if( ( ulDeleteMode % 3U ) == 1U )
            {
                /* Delete using a valid external handle derived from the pool
                 * index we used earlier, if the type is task. */
                if( ulKernelObjectType == KERNEL_OBJECT_TYPE_TASK )
                {
                    TaskHandle_t xExtHandle = ( TaskHandle_t ) CONVERT_TO_EXTERNAL_INDEX( lPoolIndex );
                    MPU_vTaskDelete( xExtHandle );
                    xTestTaskHandle = NULL;
                }
            }
            else
            {
                /* Attempt deletion using a fuzz-derived external index, which
                 * may be invalid or may not correspond to a task. This should be
                 * safely ignored by MPU_vTaskDelete. */
                TaskHandle_t xExtHandle = ( TaskHandle_t ) lExternalIndex;
                MPU_vTaskDelete( xExtHandle );
                /* We do not know if deletion actually occurred; if the index was
                 * valid and mapped to our task, it is gone; otherwise it remains.
                 * To keep the harness simple and safe, if the pool entry for our
                 * original index is now cleared, drop the handle reference. */
                if( xKernelObjectPool[ lPoolIndex ].xInternalObjectHandle == NULL )
                {
                    xTestTaskHandle = NULL;
                }
            }
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

// FreeRTOS任务包装器（非 MPU 端口，使用普通任务优先级）
void fuzz_task(void)
{
    // 创建模糊测试任务
    TaskHandle_t xHandle = xTaskCreateStatic(
        test_task,
        "FuzzTask",
        FUZZ_TASK_STACK_DEPTH,
        NULL,
        FUZZ_TASK_PRIORITY,
        xFuzzTaskStack,
        &xFuzzTaskTCB
    );

    if (xHandle == NULL) {
        printf("FuzzTask creation failed\n"); 
        fflush(stdout);
        configASSERT(0);
        for (;;) {
        }
    }

    vTaskStartScheduler();

    for (;;) {
    }
}