extern int FR_next_u16(FR_Reader *r, uint16_t *out);
extern int FR_next_u32(FR_Reader *r, uint32_t *out);
extern int FR_next_s32(FR_Reader *r, int32_t *out);
extern int FR_next_range(FR_Reader *r, int32_t min, int32_t max, int32_t *out);
extern int FR_next_bytes(FR_Reader *r, uint8_t *dst, size_t n);
extern int FR_next_string(FR_Reader *r, char *dst, size_t max_len);

/* The real timer daemon queue is internal (xTimerQueue). For fuzzing xTimerPendFunctionCall
 * we rely on the fact that the demo/application will have created it when configUSE_TIMERS=1.
 * We only need to provide callback functions and a small amount of shared state. */

/* Shared state updated by pended callbacks. */
static volatile uint32_t g_pended_call_counter = 0;
static volatile uint32_t g_pended_last_param2 = 0;
static volatile uintptr_t g_pended_last_param1 = 0;

/* Simple structures to use as pvParameter1 payloads. */
typedef struct
{
    uint32_t a;
    uint32_t b;
} FuzzParamStruct_t;

static FuzzParamStruct_t g_param_struct_1;
static FuzzParamStruct_t g_param_struct_2;

/* Forward declaration of vAssertCalled so we can invoke it from callbacks. */
void vAssertCalled( void );

/* Callback 1: increments a counter and records parameters. */
static void vPendedCallback_Record( void *pvParameter1, uint32_t ulParameter2 )
{
    g_pended_call_counter++;
    g_pended_last_param2 = ulParameter2;
    g_pended_last_param1 = ( uintptr_t ) pvParameter1;
}

/* Callback 2: manipulates a small struct pointed to by pvParameter1. */
static void vPendedCallback_MutateStruct( void *pvParameter1, uint32_t ulParameter2 )
{
    FuzzParamStruct_t *px = ( FuzzParamStruct_t * ) pvParameter1;

    if( px != NULL )
    {
        px->a ^= ulParameter2;
        px->b += ulParameter2;
    }

    g_pended_call_counter++;
}

/* Callback 3: deliberately triggers the user assert hook to exercise vAssertCalled
 * and the underlying critical section implementation. */
static void vPendedCallback_TriggerAssert( void *pvParameter1, uint32_t ulParameter2 )
{
    ( void ) pvParameter1;
    ( void ) ulParameter2;

    /* Intentionally invoke the application assert handler. */
    vAssertCalled();
}

/* Helper to select a callback based on a fuzz byte. */
static PendedFunction_t prvSelectCallback( uint8_t selector )
{
    switch( selector % 3U )
    {
        case 0U:
            return vPendedCallback_Record;

        case 1U:
            return vPendedCallback_MutateStruct;

        default:
            return vPendedCallback_TriggerAssert;
    }
}

/* Helper to select a pvParameter1 pointer based on a fuzz byte. */
static void * prvSelectParamPtr( uint8_t selector )
{
    switch( selector % 4U )
    {
        case 0U:
            return ( void * ) &g_param_struct_1;

        case 1U:
            return ( void * ) &g_param_struct_2;

        case 2U:
            /* Use NULL to exercise that path. */
            return NULL;

        default:
            /* Use an aligned integer value cast to pointer; still within our address space
             * but not dereferenced by our callbacks except in guarded ways. */
            return ( void * ) ( uintptr_t ) 0x20000000UL;
    }
}

/* Helper to optionally enter/exit critical sections around the pend call to
 * exercise vPortEnterCritical and nesting behavior. */
static void prvMaybeDoCriticalSectionPattern( uint8_t pattern )
{
    /* vPortEnterCritical is provided by the port; vPortExitCritical by the port as well. */
    extern void vPortEnterCritical( void );
    extern void vPortExitCritical( void );

    switch( pattern % 4U )
    {
        case 0U:
            /* No critical section. */
            break;

        case 1U:
            vPortEnterCritical();
            vPortExitCritical();
            break;

        case 2U:
            /* Nested critical sections. */
            vPortEnterCritical();
            vPortEnterCritical();
            vPortExitCritical();
            vPortExitCritical();
            break;

        default:
            /* Enter but let caller be responsible for exit in test_logic if desired.
             * For safety, we still balance here to avoid unbounded nesting. */
            vPortEnterCritical();
            vPortExitCritical();
            break;
    }
}


