// 主测试函数（固定骨架 + 有界迭代）
// ====================================================================
void __attribute__((used, visibility("default"))) test_task(void)
{
    // 测试用例: xTimerPendFunctionCall_vAssert_vPortEnterCritical_fuzz
    // API类别: timers
    // 描述: Fuzzes xTimerPendFunctionCall with varying callbacks, parameters, and block times while exercising vPortEnterCritical and vAssertCalled behavior under different critical section nesting patterns.

    // 统一使用 FUZZ_INPUT 构造 Reader，确保输入来源与大小一致。
    FR_Reader fr = FR_init(FUZZ_INPUT, MAX_FUZZ_INPUT_SIZE);

    // 预留少量基线缓冲，降低栈抖动和未初始化使用的风险。
    unsigned char fr_baseline[16] = {0};
    (void)FR_next_bytes(&fr, fr_baseline, sizeof(fr_baseline));

    // 统一的有界迭代次数，避免无限循环和长时间阻塞。
    // 约定：所有测试逻辑在 iterations 次迭代内完成当前输入下的探索。
    unsigned int iterations = (unsigned int)FR_next_range(&fr, 0, 10);

    // 防御性检查：确保调度器已运行，避免在错误上下文中调用阻塞 API。
    if (xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
        printf("[ERROR] Scheduler not running - aborting test_task\n");
        fflush(stdout);
        // 在 Demo 场景下直接返回，避免进一步触发 HardFault/Lockup。
        return;
    }

    // ================= 有界迭代骨架 =================
    // LLM 生成的 test_logic 将被放置在该 for 循环内部，
    // 每次迭代可执行少量 API 调用或状态变换。禁止在 test_logic 中
    // 再引入无限循环或长时间阻塞。
    for (unsigned int i = 0; i < iterations; ++i) {
        {
            /* Each iteration consumes fresh fuzz bytes to drive different configurations. */
            uint8_t cb_selector;
            uint8_t ptr_selector;
            uint8_t crit_pattern;
            uint32_t ulParam2_raw;
            uint16_t ticks_raw;
            TickType_t xTicksToWait;
            PendedFunction_t xFunc;
            void *pvParam1;
            BaseType_t xRes;

            /* Ensure we have enough bytes for this iteration: selector(3) + ulParam2(4) + ticks(2) = 9. */
            if( FR_remaining( &fr ) < 9U )
            {
                break;
            }

            if( FR_next_u8( &fr, &cb_selector ) == 0 ) break;
            if( FR_next_u8( &fr, &ptr_selector ) == 0 ) break;
            if( FR_next_u8( &fr, &crit_pattern ) == 0 ) break;
            if( FR_next_u32( &fr, &ulParam2_raw ) == 0 ) break;
            if( FR_next_u16( &fr, &ticks_raw ) == 0 ) break;

            /* Derive parameters. Clamp ticks to a small range to keep tests responsive. */
            xTicksToWait = ( TickType_t ) ( ticks_raw % 10U );

            xFunc = prvSelectCallback( cb_selector );
            pvParam1 = prvSelectParamPtr( ptr_selector );

            /* Initialize parameter structs deterministically from fuzz input evolution. */
            g_param_struct_1.a ^= ulParam2_raw;
            g_param_struct_1.b += ( ulParam2_raw >> 1 );
            g_param_struct_2.a += ( ulParam2_raw | 1U );
            g_param_struct_2.b ^= ( ulParam2_raw << 1 );

            /* Optionally exercise critical section behavior around the pend call. */
            prvMaybeDoCriticalSectionPattern( crit_pattern );

            /* Call the API under test. This will assert if the timer queue is not ready,
             * which is acceptable for fuzzing as it exercises vAssertCalled and
             * vPortEnterCritical via the application's assert handler. */
            xRes = xTimerPendFunctionCall( xFunc, pvParam1, ulParam2_raw, xTicksToWait );

            /* Basic sanity: result must be either pdPASS or an error code; we just ensure
             * it is within BaseType_t range and touch it so it is not optimized away. */
            ( void ) xRes;
        }

    }

    // =============================================
    // 关键完工标记：用于生成/修复阶段判断“本次测试逻辑已正常走完”。
    // 在 fuzzing 阶段，这行输出也不会影响 LibAFL 的行为。
    // =============================================
    printf("[TEST_CASE_COMPLETED]\n");
    fflush(stdout);

    // 调用 BREAKPOINT 函数结束本次 fuzzing；在 fuzz 阶段由 QEMU+LibAFL 进行捕获。
    BREAKPOINT();
}

